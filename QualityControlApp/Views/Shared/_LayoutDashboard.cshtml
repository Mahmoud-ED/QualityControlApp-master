@inject SignInManager<ApplicationUser> _signInManager
@inject UserManager<ApplicationUser> _userManager
@inject IUnitOfWork<UserProfile> _userProfile
@inject IUnitOfWork<SystemActivityLog> _systemActivityLog
@inject IUnitOfWork<SiteInfo> _siteInfo
@inject IUnitOfWork<QualityControlApp.Models.Entities.ImgeForViews> _imgeForViews
@inject IConfiguration Configuration

@{
    // --- معلومات الموقع والشعار ---
    var siteInfo = _siteInfo.Entity.GetAll().SingleOrDefault();
    string siteName = "E-CAA"; // اسم افتراضي
    string logoUrlForIcon = "~/img/logo.png"; // أيقونة افتراضية
    string logoUrlForViewBag = null; // للشعار في ViewBag

    if (siteInfo != null)
    {
        siteName = siteInfo.Name ?? siteName;
        if (!string.IsNullOrEmpty(siteInfo.LogoUrl))
        {
            logoUrlForIcon = $"~/pictures/{siteInfo.LogoUrl}";
            logoUrlForViewBag = siteInfo.LogoUrl; // فقط اسم الملف بدون ~/pictures/
        }
    }
    ViewBag.SiteName = siteName;
    ViewBag.LogoUrl = logoUrlForViewBag; // سيتم استخدامه في الـ navbar مع ~/pictures/

    // --- جلب الصورة للـ hero-banner بناءً على اسم الـ View الحالي ---
    string heroViewIdentifier = ViewData["HeroViewName"] as string;

    if (string.IsNullOrEmpty(heroViewIdentifier))
    {
        string currentViewPath = ViewContext.View.Path;
        if (!string.IsNullOrEmpty(currentViewPath))
        {
            heroViewIdentifier = currentViewPath.Replace("/Views/", "")
                                                .Replace(".cshtml", "")
                                                .Replace("/", "_");
        }
    }

    if (string.IsNullOrEmpty(heroViewIdentifier) || heroViewIdentifier.Equals("Home_Index", StringComparison.OrdinalIgnoreCase))
    {
        heroViewIdentifier = "DefaultHero"; // اسم افتراضي للصورة الرئيسية إذا لم يتم تحديدها
    }

    var heroImageEntry = _imgeForViews.Entity
                            .GetWhere(img => img.ViewName != null && img.ViewName.ToLower() == heroViewIdentifier.ToLower())
                            .FirstOrDefault();

    string resolvedHeroImageUrl = heroImageEntry?.CoverImageUrl ?? "/img/Captin.jpg"; // صورة افتراضية للكفر

    // --- جلب أحدث نشاط للنظام لشريط الأخبار ---
    var latestActivityForTicker = _systemActivityLog.Entity
                                .GetAll() // تأكد أن هذا لا يجلب كمية ضخمة من البيانات إذا كان الجدول كبيرًا جدًا
                                .OrderByDescending(sa => sa.ActivityDate)
                                .FirstOrDefault();
}

<!DOCTYPE html>
