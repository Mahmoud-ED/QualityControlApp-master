    <style>
        .hero-banner {
            position: relative;
            width: 100%;
            height: 300px; /* يمكنك تعديل هذا الارتفاع */
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff !important;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
            overflow: hidden; /* مهم للمنحنى السفلي */
        }

            .hero-banner::after {
                content: "";
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                height: 80px; /* ارتفاع المنحنى */
                background: #fff !important; /* لون خلفية الصفحة الرئيسية */
                border-top-left-radius: 100% 80px; /* تعديل قيم الانحناء */
                border-top-right-radius: 100% 80px; /* تعديل قيم الانحناء */
                z-index: 1;
            }

            .hero-banner h1 {
                font-size: 2.5rem; /* يمكنك تعديل حجم الخط */
                font-weight: bold;
                position: relative;
                z-index: 2; /* فوق المنحنى */
            }

        .datetime-display {
            padding: 0.5rem 0.75rem;
            color: var(--bs-navbar-color, rgba(0,0,0,.55));
            font-size: 0.9em;
            display: flex;
            align-items: center;
        }

        .navbar-dark .datetime-display {
            color: var(--bs-navbar-dark-color, rgba(255,255,255,.55));
        }

  
           .news-ticker-container {
        overflow: hidden;
        flex-grow: 1;
        white-space: nowrap;
        height: 100%; /* ليأخذ ارتفاع النافبار */
        display: flex;
        align-items: center;
        margin-left: 1rem;
        margin-right: 1rem;
        position: relative; /* مهم لبعض التأثيرات مثل الخطوط */
        /* يمكنك تجربة خلفية خفيفة جدًا */
        /* background-color: rgba(0, 0, 0, 0.03); */
        /* border-radius: 4px; */ /* إذا أردت حواف دائرية */
    }

    /* تخصيص للـ navbar الداكن */
    .navbar-dark .news-ticker-container .news-ticker-content span {
         color: rgba(255,255,255,.9); /* لون نص أوضح قليلاً في الوضع الداكن */
    }
    /* .navbar-dark .news-ticker-container { */
        /* background-color: rgba(255, 255, 255, 0.05); */ /* خلفية خفيفة للوضع الداكن */
    /* } */


    .news-ticker-content {
        display: inline-block;
        padding-left: 100%; /* يبدأ من خارج الشاشة على اليمين */
        animation: news-ticker-animation 30s linear infinite; /* عدل المدة (30s) */
        white-space: nowrap;
    }

    .news-ticker-content span {
       display: inline-block;
       font-size: 0.875em; /* حجم خط مناسب */
       color: #333; /* لون نص أساسي - عدله حسب تصميمك */
       /* text-shadow: 0px 0px 1px rgba(255,255,255,0.5); */ /* ظل خفيف للنص إذا كان الخلفية داكنة */
       vertical-align: middle; /* لمحاذاة الأيقونة والنص بشكل أفضل */
    }

    .news-ticker-content span .mdi { /* لتخصيص الأيقونة */
        font-size: 1.1em; /* حجم أكبر قليلاً للأيقونة */
        vertical-align: middle; /* محاذاة أفضل مع النص */
        margin-right: 0.3rem; /* مسافة بين الأيقونة والنص */
        color: var(--bs-primary, #0d6efd); /* استخدام لون Bootstrap الأساسي للأيقونة، أو أي لون تريده */
    }
    .navbar-dark .news-ticker-content span .mdi {
        color: rgba(255,255,255,.7); /* لون أيقونة في الوضع الداكن */
    }


    @@keyframes news-ticker-animation {
        0% {
            transform: translateX(0);
        }
        /* يمكنك إضافة توقف في البداية والنهاية إذا أردت */
        /* 5% { transform: translateX(0); } */ /* توقف لمدة قصيرة في البداية */
        100% {
            transform: translateX(-105%); /* اجعلها تتحرك أبعد قليلاً لتختفي تمامًا + مسافة صغيرة */
        }
        /* 95% { transform: translateX(-100%); } */ /* إذا أردت توقف في النهاية قبل التكرار */
    }

    .news-ticker-container:hover .news-ticker-content {
        animation-play-state: paused;
    }

    /* (اختياري) إضافة خطوط فاصلة رقيقة على جانبي الشريط */
   .news-ticker-container::before,
    .news-ticker-container::after {
        content: '';
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        height: 60%; 
        width: 1px;
        background-color: rgba(0,0,0,0.1);
    }
    .news-ticker-container::before {
        left: -10px; 
    }
    .news-ticker-container::after {
        right: -10px;
    }
    .navbar-dark .news-ticker-container::before,
    .navbar-dark .news-ticker-container::after {
        background-color: rgba(255,255,255,0.1);
    } 
        

     
    </style>
    @RenderSection("Styles", required: false) <!-- مكان إضافي للـ Styles من الـ Views -->
</head>
<body>
