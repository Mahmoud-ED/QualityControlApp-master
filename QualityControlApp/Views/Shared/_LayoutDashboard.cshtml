                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Employees" asp-action="Index">
                            <span class="icon-bg"><i class="mdi mdi-account-tie menu-icon"></i></span>
                            <span class="menu-title">Employees</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#healthManagementMenu" aria-expanded="false" aria-controls="healthManagementMenu">
                            <span class="icon-bg"><i class="mdi mdi-hospital-box menu-icon"></i></span>
                            <span class="menu-title">Health Management</span>
                            <i class="menu-arrow mdi mdi-chevron-down"></i>
                        </a>
                        <div class="collapse" id="healthManagementMenu">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item"> <a class="nav-link" asp-controller="Medicines" asp-action="Index"><span class="icon-bg ms-3"><i class="mdi mdi-pill menu-icon"></i></span>Medicines</a> </li>
                                <li class="nav-item"> <a class="nav-link" asp-controller="ChronicDisease" asp-action="Index"><span class="icon-bg ms-3"><i class="mdi mdi-heart-pulse menu-icon"></i></span>Chronic Diseases</a> </li>
                            </ul>
                        </div>
                    </li>
                   
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="collapse" href="#usersMenu" aria-expanded="false" aria-controls="usersMenu">
                                @* استخدم data-bs-toggle لـ BS5 *@
                                <span class="icon-bg"><i class="mdi mdi-account-group-outline menu-icon"></i></span>
                                <span class="menu-title">Users</span>
                                <i class="menu-arrow mdi mdi-chevron-down"></i>
                            </a>
                            <div class="collapse" id="usersMenu">
                                <ul class="nav flex-column sub-menu">
                                    <li class="nav-item"> <a class="nav-link" asp-controller="Users" asp-action="Users"><span class="icon-bg ms-3"><i class="mdi mdi-account-multiple-outline menu-icon"></i></span>Users</a> </li>
                                    <li class="nav-item"> <a class="nav-link" asp-action="Roles" asp-controller="Roles"><span class="icon-bg ms-3"><i class="mdi mdi-shield-account-outline menu-icon"></i></span>Roles</a> </li>
                                </ul>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="collapse" href="#settingsMenu" aria-expanded="false" aria-controls="settingsMenu">
                                <span class="icon-bg"><i class="mdi mdi-cog-outline menu-icon"></i></span>
                                <span class="menu-title">Settings</span>
                                <i class="menu-arrow mdi mdi-chevron-down"></i>
                            </a>
                            <div class="collapse" id="settingsMenu">
                                <ul class="nav flex-column sub-menu">
                                    <li class="nav-item"> <a class="nav-link" asp-controller="Admin" asp-action="SiteState"><span class="icon-bg ms-3"><i class="mdi mdi-power-settings menu-icon"></i></span>Site State</a> </li>
                                    <li class="nav-item"> <a class="nav-link" asp-controller="Admin" asp-action="SiteDetails"><span class="icon-bg ms-3"><i class="mdi mdi-information-outline menu-icon"></i></span>Site Info & Contact</a> </li>
                                    <li class="nav-item"> <a class="nav-link" asp-controller="SystemActivityLogs" asp-action="Index"><span class="icon-bg ms-3"><i class="mdi mdi-history menu-icon"></i></span>System Activity</a> </li>
                                    <li class="nav-item"> <a class="nav-link" asp-controller="ImgeForViews" asp-action="Index"><span class="icon-bg ms-3"><i class="mdi mdi-image-area menu-icon"></i></span>Image Covers</a> </li>
                                    <li class="nav-item"> <a class="nav-link" asp-controller="Mail" asp-action="EmailSettings"><span class="icon-bg ms-3"><i class="mdi mdi-email-cog-outline menu-icon"></i></span>Email Settings</a> </li>
                                </ul>
                            </div>
                        </li>
                    <li class="nav-item">
             
                        
                        <a class="nav-link" asp-controller="Mail" asp-action="SendEmail">
                            <span class="icon-bg"><i class="mdi mdi-email-send-outline menu-icon"></i></span>
                            <span class="menu-title">Send Email</span>
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item documentation-link">
                            <a class="nav-link" asp-action="UserProfile" asp-controller="Account" asp-route-UserId="@_userManager.GetUserId(User)" target="_blank">
                                <span class="icon-bg">
                                    <i class="mdi mdi-account-circle-outline menu-icon"></i>
                                </span>
                                <span class="menu-title">My Profile</span>
                            </a>
                        </li>
                        <li class="nav-item sidebar-user-actions">
                            <div class="sidebar-user-menu">
                                <a asp-action="Logout" asp-controller="Account" class="nav-link">
                                    <i class="mdi mdi-logout menu-icon"></i>
                                    <span class="menu-title">Log Out</span>
                                </a>
                            </div>
                        </li>
                    }
                </ul>
            </nav>

            <div class="main-panel">
                @if (!(ViewContext.RouteData.Values["controller"].ToString() == "Home" && ViewContext.RouteData.Values["action"].ToString() == "Index"))
                {
                    <div class="row mt-3 mb-0">
                        @* إزالة الهامش السفلي من هنا إذا كان hero-banner له هامش سفلي خاص به *@
                        <div class="col-12 px-0">
                            @* إزالة الـ padding الافتراضي للعمود *@
                            <div class="hero-banner" style="background-image: url('@Url.Content(resolvedHeroImageUrl)');">
                                @if (!string.IsNullOrEmpty(ViewData["Title"] as string))
                                {
                                    <h1>@ViewData["Title"]</h1>
                                }
                            </div>
                        </div>
                    </div>
                }
                <div class="content-wrapper">
                    @* إضافة content-wrapper حول RenderBody *@
                    @RenderBody()
                </div>
                <footer class="footer">
                    <div class="footer-inner-wraper">
                        <div class="d-sm-flex justify-content-center justify-content-sm-between">
                            <span>© @DateTime.Now.Year - @ViewBag.SiteName | All rights reserved.</span>
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <script src="~/assets1/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/assets1/js/off-canvas.js"></script>
    <script src="~/assets1/js/misc.js"></script>

    <environment include="Development">
        <script src="~/lib/jquery/jquery.min.js"></script>
        <script src="~/lib/twitter-bootstrap/js/bootstrap.bundle.min.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    </environment>

    <partial name="Partial/_toast" /> @* تأكد أن هذا الـ Partial موجود ويعمل بشكل صحيح *@

    @* إذا كنت تستخدم SPA مخصصًا مع هذه الملفات، اتركها. وإلا، قد لا تكون ضرورية. *@
    @* <script src="~/js/layoutAjax-spa.js"></script> *@
    @* <script src="~/js/layoutajaxloader.js"></script> *@
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>