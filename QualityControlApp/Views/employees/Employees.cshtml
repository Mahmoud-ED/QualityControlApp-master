@model IEnumerable<QualityControlApp.Models.Entities.Employee>

@{
    ViewData["Title"] = "قائمة الموظفين";
    Layout = "_LayoutDashboard"; // Assuming you use this layout
}

@* Display TempData messages *@
@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class=" rounded h-100 p-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                    <div>
                        <a asp-action="CreateEmployee" class="btn btn-primary me-2">
                            <i class="fas fa-plus me-1"></i> إضافة موظف جديد
                        </a>
                        <a asp-action="PrintAllEmployeeCards" asp-controller="Employees" class="btn btn-info" target="_blank">
                            <i class="fas fa-id-card me-1"></i> طباعة كل بطاقات الموظفين
                        </a>
                    </div>
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-bordered">
                            <thead class="table-dark">
                                <tr>
                                    <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Name)</th>
                                    <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Specialization)</th>
                                    <th>@Html.DisplayNameFor(model => model.FirstOrDefault().PhoneNumber)</th>
                                    <th>البريد الإلكتروني</th> @* For ApplicationUser.Email *@
                                    <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Gender)</th>
                                    <th>تاريخ الإنشاء</th>
                                    <th style="width: 220px;">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderByDescending(e => e.Created))
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Specialization)</td>
                                        <td><span dir="ltr">@Html.DisplayFor(modelItem => item.PhoneNumber)</span></td>
                                        <td>@item.ApplicationUser?.Email</td>
                                        <td>@Html.DisplayFor(modelItem => item.Gender)</td>
                                        <td>@item.Created.ToString("yyyy/MM/dd HH:mm")</td>
                                        <td>
                                            <a asp-controller="Employees" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1" title="تفاصيل">
                                                <i class="fas fa-info-circle"></i>
                                            </a>
                                            <a asp-action="EditEmployee" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1" title="تعديل">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('هل أنت متأكد أنك تريد حذف الموظف: \'@item.Name.Replace("'", "\\'")\'؟ هذا الإجراء لا يمكن التراجع عنه.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger" title="حذف">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                            <a asp-action="CreateHealthRecord" asp-controller="Employees" asp-route-employeeId="@item.Id" class="btn btn-sm btn-outline-secondary ms-1" title="الملف الصحي">
                                                <i class="fas fa-print"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info text-center" role="alert">
                        <i class="fas fa-info-circle me-2"></i> لا يوجد موظفون لعرضهم حاليًا. يمكنك <a asp-action="Create" class="alert-link">إضافة موظف جديد</a>.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* You might want to add pagination or DataTables.js for larger datasets later *@

@section Scripts {
    @{
        // If you use any specific JavaScript for this page (e.g., DataTables)
        // await Html.RenderPartialAsync("_ValidationScriptsPartial"); // Not strictly needed if no forms on this page besides delete
    }
}