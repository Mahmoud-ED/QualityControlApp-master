@model QualityControlApp.ViewModels.EmployeeDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل الموظف - " + (Model.Employee?.Name ?? "غير متوفر");
    Layout = "_Layout"; // تأكد من مرجع التخطيط
}

@* Display TempData messages *@
@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}

@if (Model.Employee == null)
{
    <div class="alert alert-warning text-center" role="alert">
        <h4 class="alert-heading"><i class="fas fa-exclamation-triangle"></i> لم يتم العثور على بيانات!</h4>
        <p>لا يتوفر سجل موظف لعرضه.</p>
    </div>
}
else
{
    <div class="container-fluid mt-4 px-4">

        @* === بطاقة الموظف الرئيسية - تركيز على التلخيص === *@
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white text-center">
                <i class="fas fa-user-circle fa-3x mb-2 d-block"></i>
                <h3 class="mb-0">@Model.Employee.Name</h3>
                <p class="mb-0">@Model.Employee.Specialization</p>
            </div>
            <div class="card-body p-0">

                @* === تقسيم البيانات باستخدام Tabs أو Pills لملائمة الموبايل === *@
                <ul class="nav nav-pills nav-fill p-2 border-bottom" id="employeeDetailsTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal" type="button" role="tab" aria-controls="personal" aria-selected="true">
                            <i class="fas fa-info-circle me-1 d-none d-sm-inline"></i> الشخصية
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="professional-tab" data-bs-toggle="tab" data-bs-target="#professional" type="button" role="tab" aria-controls="professional" aria-selected="false">
                            <i class="fas fa-briefcase me-1 d-none d-sm-inline"></i> المهنية
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-3" id="employeeDetailsTabContent">

                    @* --- المعلومات الشخصية (التبويب الأول) --- *@
                    <div class="tab-pane fade show active" id="personal" role="tabpanel" aria-labelledby="personal-tab">
                        <dl class="row detail-list">
                            <dt class="col-6 col-md-4">@Html.DisplayNameFor(model => model.Employee.Gender)</dt>
                            <dd class="col-6 col-md-8">@Html.DisplayFor(model => model.Employee.Gender)</dd>

                            <dt class="col-6 col-md-4">@Html.DisplayNameFor(model => model.Employee.DateOfBirth)</dt>
                            <dd class="col-6 col-md-8">@Model.Employee.DateOfBirth.ToString("yyyy/MM/dd")</dd>

                            <dt class="col-6 col-md-4">@Html.DisplayNameFor(model => model.Employee.MaritalStatus)</dt>
                            <dd class="col-6 col-md-8">@Html.DisplayFor(model => model.Employee.MaritalStatus)</dd>

                            <dt class="col-12 col-md-4">@Html.DisplayNameFor(model => model.Employee.MotherName)</dt>
                            <dd class="col-12 col-md-8">@Html.DisplayFor(model => model.Employee.MotherName)</dd>

                            <dt class="col-12 col-md-4">@Html.DisplayNameFor(model => model.Employee.PhoneNumber)</dt>
                            <dd class="col-12 col-md-8"><span dir="ltr">@Html.DisplayFor(model => model.Employee.PhoneNumber)</span></dd>

                            <dt class="col-12 col-md-4">@Html.DisplayNameFor(model => model.Employee.Address)</dt>
                            <dd class="col-12 col-md-8">@Html.DisplayFor(model => model.Employee.Address)</dd>

                            @if (Model.Employee.ApplicationUser != null)
                            {
                                <dt class="col-12 col-md-4">البريد الإلكتروني (الحساب)</dt>
                                <dd class="col-12 col-md-8">@Model.Employee.ApplicationUser.Email</dd>
                            }
                        </dl>
                    </div>

                    @* --- المعلومات المهنية (التبويب الثاني) --- *@
                    <div class="tab-pane fade" id="professional" role="tabpanel" aria-labelledby="professional-tab">
                        <dl class="row detail-list">
                            <dt class="col-6 col-md-5">@Html.DisplayNameFor(model => model.Employee.Specialization)</dt>
                            <dd class="col-6 col-md-7">@Html.DisplayFor(model => model.Employee.Specialization)</dd>

                            <dt class="col-6 col-md-5">@Html.DisplayNameFor(model => model.Employee.YearsOfExperience)</dt>
                            <dd class="col-6 col-md-7">@Html.DisplayFor(model => model.Employee.YearsOfExperience) سنة/سنوات</dd>
                        </dl>

                        @if (!string.IsNullOrWhiteSpace(Model.Employee.Bio))
                        {
                            <h6 class="mt-3 text-primary"><i class="fas fa-file-alt me-1"></i> @Html.DisplayNameFor(model => model.Employee.Bio)</h6>
                            <div class="p-3 bg-light border rounded bio-container">
                                @Html.DisplayFor(model => model.Employee.Bio)
                            </div>
                        }
                    </div>

                </div>
            </div>

            @* === قسم الإجراءات === *@
             <div class="card-footer bg-light">
                <div class="d-flex justify-content-end">
                    <a asp-controller="Employees" asp-action="PrintEmployeeCard" asp-route-id="@Model.Employee.Id" class="btn btn-info btn-sm" target="_blank">
                        <i class="fas fa-id-card me-1"></i> طباعة بطاقة الهوية
                    </a>
                </div>
            </div> 
        </div>

        @* --- قسم السجلات الصحية --- *@
        <div class="card mt-4 shadow-sm">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0"><i class="fas fa-heartbeat me-2"></i> السجل الصحي</h4>
            </div>
            <div class="card-body">
              
                @* --- عرض السجلات الصحية الحالية --- *@
                @if (Model.HealthRecords.Any())
                {
                    <h6 class="text-secondary mb-3"><i class="fas fa-list-alt me-1"></i> السجلات المسجلة:</h6>

                    @* استخدام تصميم البطاقات بدلاً من الجدول على الموبايل *@
                    <div class="row row-cols-1 g-3 d-sm-none">
                        @* يُعرض فقط على الشاشات الصغيرة (أقل من 576px) *@
                        @foreach (var record in Model.HealthRecords)
                        {
                            <div class="col">
                                <div class="card health-record-card border-left-success">
                                    <div class="card-body p-3">
                                        <h5 class="card-title text-success mb-2">@record.ChronicDisease?.Name</h5>
                                        <div class="d-flex justify-content-between align-items-center small mb-1">
                                            <span class="text-muted"><i class="far fa-calendar-alt me-1"></i> تاريخ التشخيص:</span>
                                            <strong>@record.DiagnosisDate.ToString("yyyy/MM/dd")</strong>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center small">
                                            <span class="text-muted"><i class="far fa-clock me-1"></i> تاريخ الإنشاء:</span>
                                            <span>@record.Created.ToString("yyyy/MM/dd HH:mm")</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(record.Notes))
                                        {
                                            <hr class="my-2" />
                                            <p class="card-text small text-wrap text-break">
                                                <i class="fas fa-clipboard-list me-1"></i> **ملاحظات:** @Html.DisplayFor(modelItem => record.Notes)
                                            </p>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @* استخدام الجدول على شاشات الأجهزة اللوحية والكمبيوتر (أكبر من 576px) *@
                    <div class="table-responsive d-none d-sm-block">
                        <table class="table table-striped table-hover table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>@Html.DisplayNameFor(model => model.NewHealthRecord.ChronicDisease.Name)</th>
                                    <th>@Html.DisplayNameFor(model => model.NewHealthRecord.DiagnosisDate)</th>
                                    <th>@Html.DisplayNameFor(model => model.NewHealthRecord.Notes)</th>
                                    <th>تاريخ الإنشاء</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.HealthRecords)
                                {
                                    <tr>
                                        <td>@record.ChronicDisease?.Name</td>
                                        <td>@record.DiagnosisDate.ToString("yyyy/MM/dd")</td>
                                        <td class="text-truncate" style="max-width: 250px;">@Html.DisplayFor(modelItem => record.Notes)</td>
                                        <td>@record.Created.ToString("yyyy/MM/dd HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-check-circle"></i> لا توجد سجلات صحية مسجلة لهذا الموظف حاليًا.
                    </div>
                }
            </div>
        </div>

    </div>
}

<style>
    /* تحسينات CSS للهواتف المحمولة */
    .card-header h3, .card-header h4 {
        margin-bottom: 0;
    }

    dt {
        font-weight: 600;
        /* على شاشات الموبايل، قد يكون من الأفضل جعل المفتاح يأخذ سطرًا كاملاً
               إلا إذا كانت البيانات قصيرة (مثل الجنس وتاريخ الميلاد) */
    }

    /* تحسين قائمة الوصف على الشاشات الصغيرة */
    .detail-list dd {
        margin-bottom: 0.5rem; /* زيادة التباعد بين العناصر */
    }

    /* تحسين عرض الـ Bio */
    .bio-container {
        white-space: pre-wrap;
        font-size: 0.9rem;
    }

    /* تحسينات خاصة ببطاقة السجل الصحي للموبايل */
    .health-record-card {
        border-left: 5px solid #28a745 !important; /* شريط جانبي بلون النجاح */
    }

        /* تصغير حجم الخط للعناصر داخل البطاقة للموبايل */
        .health-record-card .card-text {
            font-size: 0.85rem;
        }
</style>

@section Scripts {
    @* تفعيل تابات Bootstrap *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var triggerEl = document.querySelector('#employeeDetailsTab button[data-bs-target="#personal"]');
            if (triggerEl) {
                bootstrap.Tab.getInstance(triggerEl).show();
            }
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}