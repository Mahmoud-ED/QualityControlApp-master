@model CreateHealthRecordViewModel

@{
    ViewData["Title"] = $"إضافة سجل صحي جديد لـ {Model.EmployeeName}";
    Layout = "_LayoutDashboard"; // Or your specific layout
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class=" rounded h-100 p-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                    <a asp-action="Details" asp-controller="Employees" asp-route-id="@Model.HealthRecord.EmployeeId" class="btn btn-sm btn-outline-secondary">
                        <i class="fas  me-1"></i> العودة إلى تفاصيل الموظف
                    </a>
                </div>

                @if (TempData["error"] != null)
                {
                    <div class="alert alert-danger" role="alert">@TempData["error"]</div>
                }

                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">بيانات السجل الصحي</h6>
                    </div>
                    <div class="card-body">
                        <form asp-action="CreateHealthRecordForEmployee" asp-controller="Employees" method="post">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            @* Hidden field for EmployeeId - this is crucial and comes from the ViewModel *@
                            <input type="hidden" asp-for="Id" />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="HealthRecord.ChronicDiseaseId" class="form-label"></label>
                                    <select asp-for="HealthRecord.ChronicDiseaseId" class="form-select" asp-items="Model.ChronicDiseaseOptions">
                                        <option value="">-- اختر المرض المزمن --</option>
                                    </select>
                                    <span asp-validation-for="HealthRecord.ChronicDiseaseId" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="HealthRecord.DiagnosisDate" class="form-label"></label>
                                    <input asp-for="HealthRecord.DiagnosisDate" type="date" class="form-control" />
                                    <span asp-validation-for="HealthRecord.DiagnosisDate" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="HealthRecord.Notes" class="form-label"></label>
                                <textarea asp-for="HealthRecord.Notes" class="form-control" rows="4" placeholder="أدخل ملاحظات إضافية إذا لزم الأمر..."></textarea>
                                <span asp-validation-for="HealthRecord.Notes" class="text-danger"></span>
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="fas fa-save me-1"></i> حفظ السجل الصحي
                                </button>
                                <a asp-action="Details" asp-controller="Employees" asp-route-id="@Model.HealthRecord.EmployeeId" class="btn btn-secondary px-4 ms-2">
                                    إلغاء
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid pt-2 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">السجلات الصحية الحالية لـ @Model.EmployeeName</h6>
                    <span class="text-muted small">(@Model.HealthRecords.Count() سجل)</span>
                </div>
                <div class="card-body">
                    @if (Model.HealthRecords != null && Model.HealthRecords.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>المرض المزمن</th>
                                        <th>تاريخ التشخيص</th>
                                        <th>ملاحظات</th>
                                        <th>عدد الأدوية</th>
                                        <th>إجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var hr in Model.HealthRecords)
                                {
                                    var medsCount = hr.HealthRecordMedications?.Count() ?? 0;
                                    <tr>
                                        <td>@hr.ChronicDisease?.Name</td>
                                        <td>@hr.DiagnosisDate.ToString("yyyy/MM/dd")</td>
                                        <td style="max-width:300px">@hr.Notes</td>
                                        <td>
                                            <span class="badge @(medsCount>0?"bg-primary":"bg-secondary")">@medsCount</span>
                                        </td>
                                        <td>
                                            <a asp-controller="HealthRecordMedications" asp-action="Create" asp-route-healthRecordId="@hr.Id" class="btn btn-sm btn-success me-1" title="إضافة دواء">
                                                <i class="fas fa-plus"></i>
                                            </a>
                                            <button class="btn btn-sm btn-warning me-1" type="button" data-bs-toggle="collapse" data-bs-target="#edit-@hr.Id" aria-expanded="false" aria-controls="edit-@hr.Id">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <form asp-action="DeleteHealthRecord" asp-controller="Employees" asp-route-id="@hr.Id" method="post" class="d-inline" onsubmit="return confirm('تأكيد حذف هذا السجل الصحي؟');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger" @(medsCount>0?"disabled":"") title="حذف">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    <tr class="collapse" id="edit-@hr.Id">
                                        <td colspan="5">
                                            <form asp-action="UpdateHealthRecord" asp-controller="Employees" method="post" class="border rounded p-3 bg-light">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Id" value="@hr.Id" />
                                                <input type="hidden" name="EmployeeId" value="@hr.EmployeeId" />
                                                <div class="row g-3">
                                                    <div class="col-md-4">
                                                        <label class="form-label">المرض المزمن</label>
                                                        <select name="ChronicDiseaseId" class="form-select">
                                                            <option value="">-- اختر المرض --</option>
                                                            @foreach (var cd in Model.ChronicDiseaseOptions)
                                                            {
                                                                if (hr.ChronicDiseaseId.ToString() == cd.Value)
                                                                {
                                                                    <option value="@cd.Value" selected>@cd.Text</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@cd.Value">@cd.Text</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label">تاريخ التشخيص</label>
                                                        <input type="date" name="DiagnosisDate" value="@hr.DiagnosisDate.ToString("yyyy-MM-dd")" class="form-control" />
                                                    </div>
                                                    <div class="col-md-12">
                                                        <label class="form-label">ملاحظات</label>
                                                        <textarea name="Notes" class="form-control" rows="2">@hr.Notes</textarea>
                                                    </div>
                                                </div>
                                                <div class="mt-3 d-flex gap-2">
                                                    <button type="submit" class="btn btn-primary btn-sm">
                                                        <i class="fas fa-save"></i> حفظ
                                                    </button>
                                                    <button class="btn btn-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#edit-@hr.Id">إلغاء</button>
                                                </div>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">لا توجد سجلات صحية بعد.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}