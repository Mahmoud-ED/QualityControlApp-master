@model QualityControlApp.ViewModels.EmployeeDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل الموظف - " + (Model.Employee?.Name ?? "غير متوفر");
    Layout = "_LayoutDashboard";
}

@* --- Google Font Import --- *@
@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
}

@* Display TempData messages *@
@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}

@if (Model.Employee == null)
{
    <div class="container-fluid mt-4 px-4">
        <div class="alert alert-warning text-center">
            <h4 class="alert-heading"><i class="fas fa-exclamation-triangle"></i> خطأ</h4>
            <p>لم يتم العثور على الموظف المطلوب. قد يكون قد تم حذفه أو أن الرابط غير صحيح.</p>
        </div>
    </div>
}
else
{

    <div class="d-flex justify-content-end gap-2">
        <a asp-controller="EmployeesInfo" asp-action="Details" asp-route-id="@Model.Employee.Id" class="btn btn-primary btn-sm">
            <i class="fas fa-user-md me-1"></i> صفحة معلومات الموظف
        </a>
        <a asp-controller="Employees" asp-action="PrintEmployeeCard" asp-route-id="@Model.Employee.Id" class="btn btn-info btn-sm" target="_blank">
            <i class="fas fa-id-card me-1"></i> طباعة بطاقة الهوية
        </a>
    </div>
    <div class="profile-page-container">
        <div class="card profile-details-card mb-4">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-user-tie me-2"></i>ملف : @Model.Employee.Name</h4>
                   
                </div>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    @* --- Personal Information Section --- *@
                    <div class="col-lg-6">
                        <div class="info-section">
                            <h5 class="section-title"><i class="fas fa-info-circle me-2"></i>المعلومات الشخصية</h5>
                            <dl class="info-list">
                                <dt>@Html.DisplayNameFor(m => m.Employee.Name)</dt>
                                <dd>@Html.DisplayFor(m => m.Employee.Name)</dd>

                                <dt>@Html.DisplayNameFor(m => m.Employee.Gender)</dt>
                                <dd>@Html.DisplayFor(m => m.Employee.Gender)</dd>

                                <dt>@Html.DisplayNameFor(m => m.Employee.DateOfBirth)</dt>
                                <dd>@Model.Employee.DateOfBirth.ToString("dd / MM / yyyy")</dd>

                                <dt>@Html.DisplayNameFor(m => m.Employee.MotherName)</dt>
                                <dd>@Html.DisplayFor(m => m.Employee.MotherName)</dd>

                                <dt>@Html.DisplayNameFor(m => m.Employee.MaritalStatus)</dt>
                                <dd>@Html.DisplayFor(m => m.Employee.MaritalStatus)</dd>

                                <dt>@Html.DisplayNameFor(m => m.Employee.PhoneNumber)</dt>
                                <dd><a href="tel:@Model.Employee.PhoneNumber" dir="ltr">@Model.Employee.PhoneNumber</a></dd>

                                <dt>@Html.DisplayNameFor(m => m.Employee.Address)</dt>
                                <dd>@Html.DisplayFor(m => m.Employee.Address)</dd>

                                @if (Model.Employee.ApplicationUser != null)
                                {
                                    <dt>البريد الإلكتروني</dt>
                                    <dd><a href="mailto:@Model.Employee.ApplicationUser.Email">@Model.Employee.ApplicationUser.Email</a></dd>
                                }
                            </dl>
                        </div>
                    </div>

                    @* --- Professional Information Section --- *@
                    <div class="col-lg-6">
                        <div class="info-section">
                            <h5 class="section-title"><i class="fas fa-briefcase me-2"></i>المعلومات المهنية</h5>
                            <dl class="info-list">
                                <dt>@Html.DisplayNameFor(m => m.Employee.Specialization)</dt>
                                <dd>@Html.DisplayFor(m => m.Employee.Specialization)</dd>

                                <dt>@Html.DisplayNameFor(m => m.Employee.YearsOfExperience)</dt>
                                <dd>@Html.DisplayFor(m => m.Employee.YearsOfExperience) سنة/سنوات</dd>
                            </dl>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Employee.Bio))
                        {
                            <div class="info-section mt-4">
                                <h5 class="section-title">@Html.DisplayNameFor(m => m.Employee.Bio)</h5>
                                <div class="bio-box">
                                    @Html.DisplayFor(m => m.Employee.Bio)
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>



        @* --- Health Records Section --- *@
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0"><i class="fas fa-file-medical me-2"></i>السجل الصحي</h4>
            </div>
            <div class="card-body">
                @if (Model.HealthRecords.Any())
                {
                    <div class="health-records-list">
                        @foreach (var record in Model.HealthRecords.OrderByDescending(r => r.DiagnosisDate))
                        {
                            <div class="health-record-item">
                                <div class="record-header">
                                    <strong class="record-title">@record.ChronicDisease?.Name</strong>
                                    <span class="record-date">@record.DiagnosisDate.ToString("yyyy/MM/dd")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(record.Notes))
                                {
                                    <div class="record-body">
                                        @Html.DisplayFor(modelItem => record.Notes)
                                    </div>
                                }
                                
                                @* قسم الأدوية *@
                                @if (record.HealthRecordMedications != null && record.HealthRecordMedications.Any())
                                {
                                    <div class="medications-section">
                                        <h6 class="medications-title"><i class="fas fa-pills"></i> الأدوية الموصوفة:</h6>
                                        <div class="medications-list">
                                            @foreach (var medication in record.HealthRecordMedications.Where(m => m.IsActive).OrderBy(m => m.Medicine.Name))
                                            {
                                                <div class="medication-item">
                                                    <div class="medication-name">
                                                        <i class="fas fa-capsules"></i> <strong>@medication.Medicine.Name</strong>
                                                    </div>
                                                    <div class="medication-details">
                                                        <span class="badge bg-primary">@medication.Dosage</span>
                                                        <span class="badge bg-info">@medication.Frequency</span>
                                                    </div>
                                                    <div class="medication-actions">
                                                        <a asp-controller="HealthRecordMedications" asp-action="Edit" asp-route-id="@medication.Id" 
                                                           class="btn btn-sm btn-outline-warning" title="تعديل">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                        <a asp-controller="HealthRecordMedications" asp-action="Delete" asp-route-id="@medication.Id" 
                                                           class="btn btn-sm btn-outline-danger" title="حذف">
                                                            <i class="fas fa-trash"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        <a asp-controller="HealthRecordMedications" asp-action="Create" asp-route-healthRecordId="@record.Id" 
                                           class="btn btn-sm btn-success mt-2">
                                            <i class="fas fa-plus"></i> إضافة دواء
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <div class="medications-section">
                                        <p class="text-muted mb-2"><i class="fas fa-info-circle"></i> لا توجد أدوية موصوفة</p>
                                        <a asp-controller="HealthRecordMedications" asp-action="Create" asp-route-healthRecordId="@record.Id" 
                                           class="btn btn-sm btn-success">
                                            <i class="fas fa-plus"></i> إضافة دواء
                                        </a>
                                    </div>
                                }
                                
                                <div class="record-footer">
                                    <span>تاريخ الإنشاء: @record.Created.ToString("yyyy/MM/dd HH:mm")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-inbox empty-icon"></i>
                        <h5>لا توجد سجلات صحية</h5>
                        <p>لم يتم تسجيل أي بيانات في السجل الصحي لهذا الموظف حتى الآن.</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    :root {
        --primary-color: #0d6efd;
        --primary-color-light: #e7f0ff;
        --secondary-text: #6c757d;
        --card-bg: #ffffff;
        --body-bg: #f8f9fa;
        --border-color: #dee2e6;
        --card-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
    }

    body {
        font-family: 'Tajawal', sans-serif;
        background-color: var(--body-bg);
    }

    .profile-page-container {
        padding: 1rem;
    }

    .profile-details-card, .card {
        border: none;
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        background-color: var(--card-bg);
    }

    .card-header {
        background-color: transparent;
        border-bottom: 1px solid var(--border-color);
        padding: 1rem 1.5rem;
    }

        .card-header h4 {
            color: var(--primary-color);
            font-weight: 700;
        }

    .info-section {
        padding: 1.25rem;
        background-color: #fdfdff;
        border: 1px solid #eef2f7;
        border-radius: 10px;
        height: 100%;
    }

    .section-title {
        font-weight: 700;
        color: #343a40;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--primary-color);
        display: inline-block;
    }

    .info-list dt, .info-list dd {
        padding: 0.6rem 0;
    }

    .info-list dt {
        font-weight: 500;
        color: var(--secondary-text);
        margin-bottom: 0.25rem;
    }

    .info-list dd {
        font-weight: 500;
        color: #212529;
        margin-bottom: 0.75rem;
        padding-right: 1rem;
        border-right: 3px solid var(--primary-color-light);
    }

    dd a {
        text-decoration: none;
        color: var(--primary-color);
    }

        dd a:hover {
            text-decoration: underline;
        }

    /* Desktop view for info list */
    @@media (min-width: 992px) {
        .info-list {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 0.5rem 1.5rem;
        }

            .info-list dt, .info-list dd {
                padding: 0.5rem 0;
                margin-bottom: 0;
                border: none;
            }

            .info-list dt {
                text-align: left;
            }
    }

    .bio-box {
        background-color: var(--primary-color-light);
        padding: 1rem;
        border-radius: 8px;
        white-space: pre-wrap;
        line-height: 1.7;
        color: #343a40;
    }

    /* --- Health Records List (Mobile-First) --- */
    .health-records-list {
        display: grid;
        gap: 1rem;
    }

    .health-record-item {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 1rem;
        transition: box-shadow 0.2s ease-in-out;
    }

        .health-record-item:hover {
            box-shadow: 0 6px 12px rgba(0,0,0,0.08);
        }

    .record-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
        flex-wrap: wrap; /* for small screens */
    }

    .record-title {
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--primary-color);
    }

    .record-date {
        font-size: 0.9rem;
        color: var(--secondary-text);
        background-color: #e9ecef;
        padding: 0.2rem 0.5rem;
        border-radius: 5px;
    }

    .record-body {
        padding: 0.75rem 0;
        color: #495057;
        border-bottom: 1px dashed #e0e0e0;
    }

    .record-footer {
        padding-top: 0.75rem;
        font-size: 0.8rem;
        color: var(--secondary-text);
        text-align: left;
    }

    /* --- Empty State --- */
    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
    }

    .empty-icon {
        font-size: 4rem;
        color: #ced4da;
    }

    .empty-state h5 {
        margin-top: 1rem;
        font-weight: 700;
        color: #495057;
    }

    .empty-state p {
        color: var(--secondary-text);
    }

    /* --- Medications Section --- */
    .medications-section {
        margin-top: 1rem;
        padding: 1rem;
        background-color: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #e9ecef;
    }

    .medications-title {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.75rem;
        font-size: 0.95rem;
    }

    .medications-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .medication-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem;
        background-color: white;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .medication-name {
        flex: 1;
        min-width: 150px;
        color: #212529;
    }

        .medication-name i {
            color: var(--primary-color);
            margin-left: 0.25rem;
        }

    .medication-details {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

        .medication-details .badge {
            font-size: 0.8rem;
            padding: 0.35rem 0.6rem;
        }

    .medication-actions {
        display: flex;
        gap: 0.25rem;
    }

        .medication-actions .btn {
            padding: 0.25rem 0.5rem;
        }

    @@media (max-width: 768px) {
        .medication-item {
            flex-direction: column;
            align-items: flex-start;
        }

        .medication-actions {
            width: 100%;
            justify-content: flex-end;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}