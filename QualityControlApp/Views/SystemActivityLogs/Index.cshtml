@model PaginatedList<QualityControlApp.Models.Entities.SystemActivityLog>

@{
    ViewData["Title"] = "System Activity Logs";
}

<h1>@ViewData["Title"]</h1>

@* قسم الفلاتر (اختياري) *@
<form asp-controller="SystemActivityLogs" asp-action="Index" method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <input type="text" name="searchTerm" value="@ViewData["CurrentFilter"]" class="form-control form-control-sm" placeholder="Search description, user..." />
        </div>
        <div class="col-md-2">
            <select name="activityType" asp-items="@(new SelectList(ViewBag.ActivityTypes, ViewData["CurrentActivityType"]))" class="form-select form-select-sm">
                <option value="">All Types</option>
            </select>
        </div>
        <div class="col-md-2">
            <input type="date" name="startDate" value="@ViewData["CurrentStartDate"]" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <input type="date" name="endDate" value="@ViewData["CurrentEndDate"]" class="form-control form-control-sm" />
        </div>
        <div class="col-md-auto">
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Filter</button>
            <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="fas fa-times"></i> Clear</a>
            <a asp-action="Create" class="btn btn-secondary btn-sm"><i class="fas fa-times"></i> Add</a>
        </div>
    </div>
</form>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* <p> *@
@*     <a asp-action="Create" class="btn btn-success btn-sm"><i class="fas fa-plus"></i> Create New (Manual)</a> *@
@* </p> *@

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm">
        <thead class="table-light">
            <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Type</th>
                <th>User</th>
                <th>Related Entity</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@item.Description">
                        @item.Description
                    </td>
                    <td><span class="badge bg-info text-dark">@item.ActivityType</span></td>
                    <td>@item.UserName</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.RelatedEntityDescription))
                        {
                            @item.RelatedEntityDescription
                            @if (!string.IsNullOrEmpty(item.RelatedEntityType) && !string.IsNullOrEmpty(item.RelatedEntityId))
                            {
                                // يمكنك بناء رابط هنا إذا أردت
                                // <a href="@Url.Action("Details", item.RelatedEntityType.Replace("Request", "Requests"), new { id = item.RelatedEntityId })">
                                //     @item.RelatedEntityDescription
                                // </a>
                            }
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Details"><i class="fas fa-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm" title="Edit"><i class="fas fa-edit"></i></a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Delete"><i class="fas fa-trash-alt"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<nav aria-label="Page navigation">
    <ul class="pagination pagination-sm justify-content-center">
        <li class="page-item @prevDisabled">
            <a asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex - 1)"
               asp-route-searchTerm="@ViewData["CurrentFilter"]"
               asp-route-activityType="@ViewData["CurrentActivityType"]"
               asp-route-startDate="@ViewData["CurrentStartDate"]"
               asp-route-endDate="@ViewData["CurrentEndDate"]"
               class="page-link">Previous</a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a asp-action="Index"
                   asp-route-pageNumber="@i"
                   asp-route-searchTerm="@ViewData["CurrentFilter"]"
                   asp-route-activityType="@ViewData["CurrentActivityType"]"
                   asp-route-startDate="@ViewData["CurrentStartDate"]"
                   asp-route-endDate="@ViewData["CurrentEndDate"]"
                   class="page-link">@i</a>
            </li>
        }
        <li class="page-item @nextDisabled">
            <a asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex + 1)"
               asp-route-searchTerm="@ViewData["CurrentFilter"]"
               asp-route-activityType="@ViewData["CurrentActivityType"]"
               asp-route-startDate="@ViewData["CurrentStartDate"]"
               asp-route-endDate="@ViewData["CurrentEndDate"]"
               class="page-link">Next</a>
        </li>
    </ul>
</nav>
<div>Total Activities: @Model.TotalCount</div>