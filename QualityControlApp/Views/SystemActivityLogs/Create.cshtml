@model QualityControlApp.ViewModels.SystemActivityLogVM

@{
    ViewData["Title"] = "Create System Activity Log";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>@ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="ActivityDate" class="form-label fw-semibold"></label>
                            <input asp-for="ActivityDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ActivityType" class="form-label fw-semibold"></label>
                                <input asp-for="ActivityType" class="form-control" placeholder="e.g., UserLogin, DataUpdate" />
                                <span asp-validation-for="ActivityType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserName" class="form-label fw-semibold"></label>
                                <input asp-for="UserName" class="form-control" placeholder="Username if applicable" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserId" class="form-label fw-semibold"></label>
                                <input asp-for="UserId" class="form-control" placeholder="User ID if applicable" />
                                <span asp-validation-for="UserId" class="text-danger small"></span>
                            </div>
                        </div>


                        <h5 class="mt-4 mb-3 text-muted border-bottom pb-2">Related Entity (Optional)</h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="RelatedEntityType" class="form-label fw-semibold"></label>
                                <input asp-for="RelatedEntityType" class="form-control" placeholder="e.g., AirPortRequest, Landing" />
                                <span asp-validation-for="RelatedEntityType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="RelatedEntityId" class="form-label fw-semibold"></label>
                                <input asp-for="RelatedEntityId" class="form-control" placeholder="ID of the related entity" />
                                <span asp-validation-for="RelatedEntityId" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="RelatedEntityDescription" class="form-label fw-semibold"></label>
                            <input asp-for="RelatedEntityDescription" class="form-control" placeholder="Short description of related entity" />
                            <span asp-validation-for="RelatedEntityDescription" class="text-danger small"></span>
                        </div>

                        <div class="mt-4 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-times me-1"></i> Cancel</a>
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Create Log</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // للتعامل مع نوع الإدخال datetime-local بشكل أفضل إذا لم يكن المتصفح يدعمه بالكامل
        // أو لتعيين القيمة الافتراضية بشكل صحيح
        (function () {
            var dateInput = document.querySelector('input[type="datetime-local"][name="ActivityDate"]');
            if (dateInput && !dateInput.value) {
                var now = new Date();
                now.setMinutes(now.getMinutes() - now.getTimezoneOffset()); // Adjust for local timezone
                // Format to YYYY-MM-DDTHH:MM
                var yyyy = now.getFullYear();
                var mm = ('0' + (now.getMonth() + 1)).slice(-2);
                var dd = ('0' + now.getDate()).slice(-2);
                var hh = ('0' + now.getHours()).slice(-2);
                var min = ('0' + now.getMinutes()).slice(-2);
                dateInput.value = `${yyyy}-${mm}-${dd}T${hh}:${min}`;
            }
        })();
    </script>
}