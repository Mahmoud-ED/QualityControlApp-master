@model QualityControlApp.ViewModels.EmployeeDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل الموظف - " + (Model.Employee?.Name ?? "غير متوفر");
    Layout = "_Layout"; // Or your specific layout like "_LayoutDashboard"
}

@* --- Google Font Import --- *@
@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    @* Using Font Awesome for icons, ensure it's included in your layout *@
}

@* Display TempData messages *@
@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}

@if (Model.Employee == null)
{
    <div class="container-fluid mt-4 px-4">
        <div class="alert alert-warning text-center">
            <h4 class="alert-heading"><i class="fas fa-exclamation-triangle"></i> خطأ</h4>
            <p>لم يتم العثور على الموظف المطلوب. قد يكون قد تم حذفه أو أن الرابط غير صحيح.</p>
        </div>

        @* --- All Medications Section --- *@
        <div class="card mt-4">
            <div class="card-header">
                <h4 class="mb-0"><i class="fas fa-pills me-2"></i>جميع الأدوية للموظف</h4>
            </div>
            <div class="card-body">
                @{
                    var allMeds = Model.HealthRecords
                        .Where(hr => hr.HealthRecordMedications != null)
                        .SelectMany(hr => hr.HealthRecordMedications.Select(m => new {
                            Disease = hr.ChronicDisease?.Name,
                            Medicine = m.Medicine?.Name,
                            m.Dosage,
                            m.Frequency,
                            m.StartDate,
                            m.EndDate,
                            m.IsActive
                        }))
                        .ToList();
                }
                @if (allMeds.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>المرض</th>
                                    <th>الدواء</th>
                                    <th>الجرعة</th>
                                    <th>التكرار</th>
                                    <th>تاريخ البدء</th>
                                    <th>تاريخ الانتهاء</th>
                                    <th>الحالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in allMeds.OrderByDescending(x => x.IsActive).ThenByDescending(x => x.StartDate))
                                {
                                    <tr>
                                        <td>@(item.Disease ?? "-")</td>
                                        <td>@(item.Medicine ?? "-")</td>
                                        <td>@(item.Dosage ?? "-")</td>
                                        <td>@(item.Frequency ?? "-")</td>
                                        <td>@(item.StartDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                        <td>@(item.EndDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success">نشط</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">غير نشط</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted">لا توجد أدوية مسجلة لهذا الموظف.</div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="profile-page-container">
        @* --- Employee Details Card --- *@
        <div class="card profile-details-card mb-4">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-user-tie me-2"></i>ملف الموظف: @Model.Employee.Name</h4>
                    <a asp-controller="Employees" asp-action="PrintEmployeeCard" asp-route-id="@Model.Employee.Id" class="btn btn-primary btn-sm" target="_blank">
                        <i class="fas fa-id-card me-1"></i> طباعة البطاقة
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    @* --- Personal Information Section --- *@
                    <div class="col-lg-6">
                        <div class="info-section">
                            <h5 class="section-title"><i class="fas fa-info-circle me-2"></i>المعلومات الشخصية</h5>
                            <dl class="info-list">
                                <dt>@Html.DisplayNameFor(m => m.Employee.Name)</dt>
                                <dd>@Html.DisplayFor(m => m.Employee.Name)</dd>

                                <dt>@Html.DisplayNameFor(m => m.Employee.Gender)</dt>
                                <dd>@Html.DisplayFor(m => m.Employee.Gender)</dd>

                                <dt>@Html.DisplayNameFor(m => m.Employee.DateOfBirth)</dt>
                                <dd>@Model.Employee.DateOfBirth.ToString("dd / MM / yyyy")</dd>

                                <dt>@Html.DisplayNameFor(m => m.Employee.PhoneNumber)</dt>
                                <dd><a href="tel:@Model.Employee.PhoneNumber" dir="ltr">@Model.Employee.PhoneNumber</a></dd>

                                <dt>@Html.DisplayNameFor(m => m.Employee.Address)</dt>
                                <dd>@Html.DisplayFor(m => m.Employee.Address)</dd>
                            </dl>
                        </div>
                    </div>

                    @* --- Professional Information Section --- *@
                    <div class="col-lg-6">
                        <div class="info-section">
                            <h5 class="section-title"><i class="fas fa-briefcase me-2"></i>المعلومات المهنية</h5>
                            <dl class="info-list">
                                <dt>@Html.DisplayNameFor(m => m.Employee.Specialization)</dt>
                                <dd>@Html.DisplayFor(m => m.Employee.Specialization)</dd>

                                <dt>@Html.DisplayNameFor(m => m.Employee.YearsOfExperience)</dt>
                                <dd>@Html.DisplayFor(m => m.Employee.YearsOfExperience) سنة/سنوات</dd>

                                @if (Model.Employee.ApplicationUser != null)
                                {
                                    <dt>البريد الإلكتروني</dt>
                                    <dd><a href="mailto:@Model.Employee.ApplicationUser.Email">@Model.Employee.ApplicationUser.Email</a></dd>
                                }
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* --- Health Status Section --- *@
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0"><i class="fas fa-heartbeat me-2"></i>الحالة الصحية للموظف</h4>
            </div>
            <div class="card-body">
                @if (Model.AllChronicDiseases != null && Model.AllChronicDiseases.Any())
                {
                    <div class="health-status-grid">
                        @foreach (var disease in Model.AllChronicDiseases.OrderBy(d => d.Name))
                        {
                            var healthRecord = Model.HealthRecords.FirstOrDefault(hr => hr.ChronicDiseaseId == disease.Id);
                            var isAffected = healthRecord != null;

                            <div class="health-status-card @(isAffected ? "affected" : "healthy")">
                                <div class="status-header">
                                    <i class="status-icon fas @(isAffected ? "fa-exclamation-triangle" : "fa-shield-alt")"></i>
                                    <h6 class="disease-name">@disease.Name</h6>
                                    <span class="status-badge badge @(isAffected ? "bg-danger" : "bg-success")">
                                        @(isAffected ? "مصاب" : "سليم")
                                    </span>
                                </div>
                                @if (isAffected)
                                {
                                    <div class="status-details">
                                        <dl>
                                            <dt>تاريخ التشخيص:</dt>
                                            <dd>@healthRecord.DiagnosisDate.ToString("yyyy/MM/dd")</dd>
                                            @if (!string.IsNullOrWhiteSpace(healthRecord.Notes))
                                            {
                                                <dt>ملاحظات:</dt>
                                                <dd>@healthRecord.Notes</dd>
                                            }
                                        </dl>
                                        @if (healthRecord.HealthRecordMedications != null && healthRecord.HealthRecordMedications.Any())
                                        {
                                            <div class="mt-3">
                                                <h6 class="mb-2">الأدوية المرتبطة</h6>
                                                <div class="table-responsive">
                                                    <table class="table table-sm align-middle">
                                                        <thead>
                                                            <tr>
                                                                <th>الدواء</th>
                                                                <th>الجرعة</th>
                                                                <th>التكرار</th>
                                                                <th>تاريخ البدء</th>
                                                                <th>تاريخ الانتهاء</th>
                                                                <th>الحالة</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var med in healthRecord.HealthRecordMedications.OrderByDescending(m => m.IsActive).ThenByDescending(m => m.StartDate))
                                                            {
                                                                <tr>
                                                                    <td>@(med.Medicine?.Name ?? "-")</td>
                                                                    <td>@(med.Dosage ?? "-")</td>
                                                                    <td>@(med.Frequency ?? "-")</td>
                                                                    <td>@(med.StartDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                                                    <td>@(med.EndDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                                                    <td>
                                                                        @if (med.IsActive)
                                                                        {
                                                                            <span class="badge bg-success">نشط</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-secondary">غير نشط</span>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-file-medical-alt empty-icon"></i>
                        <h5>لا توجد أمراض معرفة</h5>
                        <p>يرجى إضافة الأمراض المزمنة في إعدادات النظام أولاً لعرض حالة الموظف.</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    :root {
        --primary-color: #0d6efd;
        --success-color: #198754;
        --danger-color: #dc3545;
        --success-light-bg: #e8f3ee;
        --danger-light-bg: #fbebec;
        --secondary-text: #6c757d;
        --card-bg: #ffffff;
        --body-bg: #f8f9fa;
        --border-color: #dee2e6;
        --card-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
    }

    body {
        font-family: 'Tajawal', sans-serif;
        background-color: var(--body-bg);
    }

    .profile-page-container {
        padding: 1rem;
    }

    .profile-details-card, .card {
        border: none;
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        background-color: var(--card-bg);
    }

    .card-header {
        background-color: transparent;
        border-bottom: 1px solid var(--border-color);
        padding: 1rem 1.5rem;
    }

        .card-header h4 {
            color: var(--primary-color);
            font-weight: 700;
        }

    /* --- Info Sections from previous design (re-used for consistency) --- */
    .info-section {
        padding: 1.25rem;
        background-color: #fdfdff;
        border: 1px solid #eef2f7;
        border-radius: 10px;
        height: 100%;
    }

    .section-title {
        font-weight: 700;
        color: #343a40;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--primary-color);
        display: inline-block;
    }

    .info-list {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.5rem 1.5rem;
    }

        .info-list dt {
            font-weight: 500;
            color: var(--secondary-text);
            text-align: left;
        }

        .info-list dd {
            font-weight: 500;
            color: #212529;
        }

    dd a {
        text-decoration: none;
        color: var(--primary-color);
    }

        dd a:hover {
            text-decoration: underline;
        }

    /* --- Health Status Grid (New) --- */
    .health-status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.25rem;
    }

    .health-status-card {
        border: 1px solid var(--border-color);
        border-radius: 10px;
        transition: all 0.2s ease-in-out;
        overflow: hidden; /* To ensure child borders don't overflow */
    }

        .health-status-card.healthy {
            border-left: 5px solid var(--success-color);
        }

        .health-status-card.affected {
            border-left: 5px solid var(--danger-color);
        }

        .health-status-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.08);
        }

    .status-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
    }

    .health-status-card.healthy .status-header {
        background-color: var(--success-light-bg);
    }

    .health-status-card.affected .status-header {
        background-color: var(--danger-light-bg);
    }

    .status-icon {
        font-size: 1.5rem;
    }

    .health-status-card.healthy .status-icon {
        color: var(--success-color);
    }

    .health-status-card.affected .status-icon {
        color: var(--danger-color);
    }

    .disease-name {
        flex-grow: 1;
        margin-bottom: 0;
        font-weight: 700;
        color: #343a40;
    }

    .status-badge {
        font-size: 0.8rem;
        padding: 0.3em 0.6em;
    }

    .status-details {
        padding: 0 1rem 1rem 1rem;
        border-top: 1px dashed var(--border-color);
    }

        .status-details dl {
            margin: 1rem 0 0 0;
            font-size: 0.9rem;
        }

        .status-details dt {
            font-weight: 700;
            color: var(--secondary-text);
            margin-bottom: 0.25rem;
        }

        .status-details dd {
            margin-right: 1rem;
            margin-bottom: 0.75rem;
            color: #212529;
            white-space: pre-wrap; /* For notes to wrap */
        }

    /* --- Empty State --- */
    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
    }

    .empty-icon {
        font-size: 4rem;
        color: #ced4da;
    }

    .empty-state h5 {
        margin-top: 1rem;
        font-weight: 700;
        color: #495057;
    }

    .empty-state p {
        color: var(--secondary-text);
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}