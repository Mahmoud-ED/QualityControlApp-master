@{
    ViewData["Title"] = "Landing Status Report";
    var statusStats = ViewBag.StatusStats as IEnumerable<dynamic>;
    var statusByOperator = ViewBag.StatusByOperator as IEnumerable<dynamic>;
}

<div class="container-fluid py-4">

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1"><i class="fas fa-chart-pie me-2 text-success"></i>@ViewData["Title"]</h1>
            <p class="text-muted mb-0">Analysis of landing requests by status with distribution charts and detailed breakdowns.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Reports")" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                <i class="fas fa-arrow-left me-2"></i> Back to Reports
            </a>
            <button onclick="refreshData()" class="btn btn-primary rounded-pill px-4 py-2">
                <i class="fas fa-sync-alt me-2"></i> Refresh Data
            </button>
        </div>
    </div>

    <!-- Status Overview Cards -->
    <div class="row g-4 mb-5">
        @if (statusStats != null && statusStats.Any())
        {
            @foreach (var stat in statusStats)
            {
                var bgClass = stat.Status == "Approved" ? "bg-success" :
                             stat.Status == "Rejected" ? "bg-danger" :
                             stat.Status == "Pending" ? "bg-warning" : "bg-secondary";
                var textClass = stat.Status == "Pending" ? "text-dark" : "text-white";
                var iconClass = stat.Status == "Approved" ? "fas fa-check-circle" :
                               stat.Status == "Rejected" ? "fas fa-times-circle" :
                               stat.Status == "Pending" ? "fas fa-clock" : "fas fa-question-circle";

                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="icon-circle @bgClass @textClass">
                                    <i class="@iconClass fa-2x"></i>
                                </div>
                                <div class="text-end">
                                    <h4 class="mb-0 fw-bold">@stat.Count</h4>
                                    <small class="text-muted">@stat.Percentage%</small>
                                </div>
                            </div>
                            <h6 class="card-title fw-semibold mb-0">@stat.Status</h6>
                            <div class="progress mt-3" style="height: 6px;">
                                <div class="progress-bar @bgClass" role="progressbar"
                                     style="width: @stat.Percentage%"
                                     aria-valuenow="@stat.Percentage"
                                     aria-valuemin="0"
                                     aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Charts Section -->
    <div class="row g-4 mb-5">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light py-3">
                    <h6 class="fw-semibold text-dark mb-0"><i class="fas fa-chart-pie me-2"></i>Status Distribution</h6>
                </div>
                <div class="card-body d-flex justify-content-center align-items-center">
                    <canvas id="statusChart" style="max-width: 400px; max-height: 400px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light py-3">
                    <h6 class="fw-semibold text-dark mb-0"><i class="fas fa-chart-bar me-2"></i>Status by Operator</h6>
                </div>
                <div class="card-body">
                    <canvas id="statusByOperatorChart" style="max-height: 400px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Tables Section -->
    <div class="row g-4 mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light py-3">
                    <h6 class="fw-semibold text-dark mb-0"><i class="fas fa-table me-2"></i>Status Summary Table</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 fw-semibold">Status</th>
                                    <th class="border-0 fw-semibold text-center">Count</th>
                                    <th class="border-0 fw-semibold text-center">Percentage</th>
                                    <th class="border-0 fw-semibold text-center">Visual</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (statusStats != null && statusStats.Any())
                                {
                                    @foreach (var stat in statusStats)
                                    {
                                        var bgClass = stat.Status == "Approved" ? "bg-success" :
                                                     stat.Status == "Rejected" ? "bg-danger" :
                                                     stat.Status == "Pending" ? "bg-warning" : "bg-secondary";

                                        <tr>
                                            <td class="border-0 fw-semibold">@stat.Status</td>
                                            <td class="border-0 text-center">@stat.Count</td>
                                            <td class="border-0 text-center">@stat.Percentage%</td>
                                            <td class="border-0 text-center">
                                                <div class="progress" style="width: 100px; height: 8px; margin: 0 auto;">
                                                    <div class="progress-bar @bgClass" role="progressbar"
                                                         style="width: @stat.Percentage%"
                                                         aria-valuenow="@stat.Percentage"
                                                         aria-valuemin="0"
                                                         aria-valuemax="100"></div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="border-0 text-center text-muted py-4">No status data available</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status by Operator Table -->
    @if (statusByOperator != null && statusByOperator.Any())
    {
        <div class="row g-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h6 class="fw-semibold text-dark mb-0"><i class="fas fa-building me-2"></i>Status Distribution by Operator</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-0 fw-semibold">Operator Name</th>
                                        <th class="border-0 fw-semibold text-center">Status</th>
                                        <th class="border-0 fw-semibold text-center">Count</th>
                                        <th class="border-0 fw-semibold text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in statusByOperator)
                                    {
                                        var badgeClass = item.Status == "Approved" ? "bg-success" :
                                                        item.Status == "Rejected" ? "bg-danger" :
                                                        item.Status == "Pending" ? "bg-warning text-dark" : "bg-secondary";

                                        <tr>
                                            <td class="border-0 fw-semibold">@item.OperatorName</td>
                                            <td class="border-0 text-center">
                                                <span class="badge @badgeClass">@item.Status</span>
                                            </td>
                                            <td class="border-0 text-center fw-semibold">@item.Count</td>
                                            <td class="border-0 text-center">
                                                <button class="btn btn-sm btn-outline-primary" onclick="viewOperatorDetails('@item.OperatorName', '@item.Status')">
                                                    <i class="fas fa-eye me-1"></i> Details
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@section Styles {
    <style>
        body {
            background-color: #f8f9fa;
        }

        .icon-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            border-radius: 0.75rem;
        }

        .table th {
            font-size: 0.875rem;
            border-bottom: 2px solid #e9ecef;
        }

        .table td {
            font-size: 0.875rem;
            vertical-align: middle;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(0, 123, 255, 0.05);
        }

        .badge {
            font-size: 0.75rem;
        }

        .progress {
            border-radius: 3px;
        }

        .progress-bar {
            border-radius: 3px;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

    <script>
        let statusChart = null;
        let statusByOperatorChart = null;

        document.addEventListener('DOMContentLoaded', function () {
            initializeCharts();
        });

        function initializeCharts() {
            // Status Distribution Chart
            const statusCtx = document.getElementById('statusChart');
            if (statusCtx && @Json.Serialize(statusStats)) {
                const statusData = @Json.Serialize(statusStats);
                const colors = {
                    'Approved': ['rgba(25, 135, 84, 0.8)', 'rgba(25, 135, 84, 1)'],
                    'Rejected': ['rgba(220, 53, 69, 0.8)', 'rgba(220, 53, 69, 1)'],
                    'Pending': ['rgba(255, 193, 7, 0.8)', 'rgba(255, 193, 7, 1)']
                };

                statusChart = new Chart(statusCtx, {
                    type: 'doughnut',
                    data: {
                        labels: statusData.map(item => item.Status),
                        datasets: [{
                            data: statusData.map(item => item.Count),
                            backgroundColor: statusData.map(item => colors[item.Status] ? colors[item.Status][0] : 'rgba(108, 117, 125, 0.8)'),
                            borderColor: statusData.map(item => colors[item.Status] ? colors[item.Status][1] : 'rgba(108, 117, 125, 1)'),
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 20,
                                    usePointStyle: true
                                }
                            }
                        }
                    }
                });
            }

            // Status by Operator Chart
            const operatorCtx = document.getElementById('statusByOperatorChart');
            if (operatorCtx && @Json.Serialize(statusByOperator)) {
                const operatorData = @Json.Serialize(statusByOperator);

                // Group by operator for the chart
                const operatorGroups = {};
                operatorData.forEach(item => {
                    if (!operatorGroups[item.OperatorName]) {
                        operatorGroups[item.OperatorName] = {};
                    }
                    operatorGroups[item.OperatorName][item.Status] = item.Count;
                });

                const operators = Object.keys(operatorGroups);
                const statuses = ['Approved', 'Rejected', 'Pending'];

                statusByOperatorChart = new Chart(operatorCtx, {
                    type: 'bar',
                    data: {
                        labels: operators,
                        datasets: statuses.map(status => ({
                            label: status,
                            data: operators.map(op => operatorGroups[op][status] || 0),
                            backgroundColor: status === 'Approved' ? 'rgba(25, 135, 84, 0.7)' :
                                           status === 'Rejected' ? 'rgba(220, 53, 69, 0.7)' :
                                           'rgba(255, 193, 7, 0.7)',
                            borderColor: status === 'Approved' ? 'rgba(25, 135, 84, 1)' :
                                       status === 'Rejected' ? 'rgba(220, 53, 69, 1)' :
                                       'rgba(255, 193, 7, 1)',
                            borderWidth: 1
                        }))
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: {
                                stacked: true,
                            },
                            y: {
                                stacked: true,
                                beginAtZero: true
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'top'
                            }
                        }
                    }
                });
            }
        }

        function refreshData() {
            location.reload();
        }

        function viewOperatorDetails(operatorName, status) {
            // Navigate to detailed report with filters
            const url = '@Url.Action("DetailedReport", "Landing")' +
                       `?operatorName=${encodeURIComponent(operatorName)}&requestStatus=${status}`;
            window.location.href = url;
        }
    </script>
}
