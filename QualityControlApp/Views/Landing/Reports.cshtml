        // تحميل البيانات عند بدء الصفحة
        document.addEventListener('DOMContentLoaded', function() {
            loadChartData();

            // إضافة event listeners للأزرار
            const exportButtons = document.querySelectorAll('a[href*="Export"]');
            exportButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    const originalHtml = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>جاري المعالجة...';
                    this.classList.add('disabled');

                    setTimeout(() => {
                        this.innerHTML = originalHtml;
                        this.classList.remove('disabled');
                    }, 3000);
                });
            });

            // تحديث تلقائي كل دقيقة
            setInterval(() => {
                console.log('تحديث تلقائي للبيانات...');
                loadChartData();
            }, 60000);

            // Resize على تغيير حجم النافذة
            window.addEventListener('resize', () => {
                Object.values(charts).forEach(ch => { try { ch.resize(); } catch(e){} });
            });
        });

        // دالة لتصدير الشارت كصورة
        function exportChartAsImage(chartId, filename) {
            const chart = charts[chartId];
            if (chart) {
                const link = document.createElement('a');
                link.download = filename || 'chart.png';
                link.href = chart.getDataURL({ type: 'png', pixelRatio: 2, backgroundColor: '#fff' });
                link.click();
            }
        }

        // دالة للطباعة
        function printChart(chartId) {
            const chart = charts[chartId];
            if (chart) {
                const dataUrl = chart.getDataURL({ type: 'png', pixelRatio: 2, backgroundColor: '#fff' });
                const windowContent = `
                    <html>
                        <head><title>Print Chart</title></head>
                        <body style="text-align: center;">
                            <img src="${dataUrl}" style="max-width: 100%; height: auto;" />
                        </body>
                    </html>
                `;
                const printWindow = window.open('', '_blank');
                printWindow.document.open();
                printWindow.document.write(windowContent);
                printWindow.document.close();
                printWindow.print();
            }
        }
    </script>
}
