            // إنشاء الشارتس بالبيانات التجريبية
            createAnimatedPieChart('operatorsChart', operatorsData, 'توزيع الطلبات حسب المشغل');
            createAnimatedLineChart('monthlyTrendsChart', monthlyData, 'الاتجاهات الشهرية', 'الشهر', 'عدد الطلبات');
            createAnimatedBarChart('aircraftTypesChart', {
                labels: aircraftTypesData.map(item => item.label),
                values: aircraftTypesData.map(item => item.value)
            }, 'توزيع أنواع الطائرات', 'نوع الطائرة', 'عدد الرحلات');
