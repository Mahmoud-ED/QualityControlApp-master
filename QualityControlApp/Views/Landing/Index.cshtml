@model IEnumerable<QualityControlApp.Models.Entities.Landing>

@{
    ViewData["Title"] = "Landings List";
    var currentOperatorName = ViewContext.HttpContext.Request.Query["operatorName"].FirstOrDefault();
    var currentAircraftReg = ViewContext.HttpContext.Request.Query["aircraftReg"].FirstOrDefault();
    var currentFlightDateFrom = ViewContext.HttpContext.Request.Query["flightDateFrom"].FirstOrDefault();
    var currentFlightDateTo = ViewContext.HttpContext.Request.Query["flightDateTo"].FirstOrDefault();
}

<div class="container-fluid py-4">

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1"><i class="fas fa-plane-arrival me-2 text-primary"></i>@ViewData["Title"]</h1>
            <p class="text-muted mb-0">Browse, filter, and manage aircraft landing records.</p>
        </div>
        <a href="@Url.Action("Create")" class="btn btn-primary rounded-pill shadow-sm px-4 py-2">
            <i class="fas fa-plus-circle me-2"></i> Add New Landing Record
        </a>
    </div>

    <!-- Filters & Search Section -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-light py-3 border-bottom-0">
            <a class="h6 fw-semibold text-decoration-none text-dark d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#searchFilterCollapse" role="button" aria-expanded="false" aria-controls="searchFilterCollapse">
                <span><i class="fas fa-filter me-2"></i>Search & Filter Options</span>
                <i class="fas fa-chevron-down collapse-icon"></i>
            </a>
        </div>
        <div class="collapse" id="searchFilterCollapse">
            <div class="card-body p-4">
                <form method="get" asp-action="Index" class="row g-3">
                    <div class="col-md-5">
                        <label for="operatorNameFilter" class="form-label small fw-semibold">Operator Name</label>
                        <input type="text" id="operatorNameFilter" name="operatorName" class="form-control form-control-sm" placeholder="Enter operator name" value="@currentOperatorName" />
                    </div>
                    <div class="col-md-4">
                        <label for="aircraftRegFilter" class="form-label small fw-semibold">Aircraft Registration</label>
                        <input type="text" id="aircraftRegFilter" name="aircraftReg" class="form-control form-control-sm" placeholder="Enter aircraft registration" value="@currentAircraftReg" />
                    </div>
                    <div class="col-md-3"></div>
                    <div class="col-12"><hr class="my-2"><h6 class="small fw-bold text-muted text-uppercase">Flight Date Range</h6></div>
                    <div class="col-md-3">
                        <label for="flightDateFromFilter" class="form-label small fw-semibold">From</label>
                        <input type="date" id="flightDateFromFilter" name="flightDateFrom" class="form-control form-control-sm" value="@currentFlightDateFrom" />
                    </div>
                    <div class="col-md-3">
                        <label for="flightDateToFilter" class="form-label small fw-semibold">To</label>
                        <input type="date" id="flightDateToFilter" name="flightDateTo" class="form-control form-control-sm" value="@currentFlightDateTo" />
                    </div>
                    <div class="col-md-6"></div>
                    <div class="col-12 mt-4 d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-4">
                            <i class="fas fa-undo me-1"></i> Reset Filters
                        </a>
                        <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4">
                            <i class="fas fa-search me-1"></i> Apply Filters
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var landing in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3 request-card">
                        <div class="card-header bg-transparent py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                            <span class="fw-semibold text-primary">@landing.AircraftRegistration</span>
                        </div>
                        <div class="card-body p-4">
                            <div class="mb-2">
                                <small class="text-muted d-block">Operator</small>
                                <p class="fw-semibold mb-0">@landing.OperatorName</p>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted d-block">Aircraft Type</small>
                                <p class="fw-semibold mb-0">@landing.AircraftType</p>
                            </div>
                            <div class="row gx-3">
                                <div class="col-sm-6 mb-2">
                                    <small class="text-muted d-block">Flight Date</small>
                                    <p class="fw-semibold mb-0">@landing.DateOfFlights.ToString("dd MMM yyyy")</p>
                                </div>
                                <div class="col-sm-6 mb-2">
                                    <small class="text-muted d-block">Flight Number</small>
                                    <p class="fw-semibold mb-0">@landing.FlightNumber ?? "N/A"</p>
                                </div>
                                <div class="col-sm-6 mb-2">
                                    <small class="text-muted d-block">ETA</small>
                                    <p class="fw-semibold mb-0">@landing.ETA.ToString("HH:mm")</p>
                                </div>
                                <div class="col-sm-6 mb-2">
                                    <small class="text-muted d-block">ETD</small>
                                    <p class="fw-semibold mb-0">@landing.ETD.ToString("HH:mm")</p>
                                </div>
                                <div class="col-12 mb-2">
                                    <small class="text-muted d-block">Route</small>
                                    <p class="fw-semibold mb-0">@landing.Route ?? "N/A"</p>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white py-3 px-4 border-top-0">
                            <div class="d-flex justify-content-start gap-2 flex-wrap">
                                <a href="@Url.Action("Details", new { id = landing.Id })" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="View Details"><i class="fas fa-eye me-1"></i> Details</a>
                                <a href="@Url.Action("Edit", new { id = landing.Id })" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Edit Landing Record"><i class="fas fa-pencil-alt me-1"></i> Edit</a>
                                <form asp-action="Delete" asp-route-id="@landing.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this landing record?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Delete Landing Record"><i class="fas fa-trash me-1"></i> Delete</button>
                                </form>
                                <a href="@Url.Action("ChangeStatus", new { id = landing.Id })" class="btn btn-sm btn-outline-info rounded-pill px-3" title="Change Status"><i class="fas fa-exchange-alt me-1"></i> Status</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="card border-0 shadow-sm mx-auto" style="max-width: 480px;">
                <div class="card-body p-lg-5 p-4">
                    <img src="/images/no-data-illustration.svg" alt="No landing records found" class="img-fluid mb-4" style="max-height: 200px;" />
                    <h3 class="fw-bold text-dark mb-3">No Landing Records Found</h3>
                    @if (!string.IsNullOrEmpty(currentOperatorName) || !string.IsNullOrEmpty(currentAircraftReg) || !string.IsNullOrEmpty(currentFlightDateFrom) || !string.IsNullOrEmpty(currentFlightDateTo))
                    {
                        <p class="text-muted mb-4">No landing records match your current filter criteria. Try adjusting or clearing them.</p>
                        <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 py-2"><i class="fas fa-undo me-2"></i> Clear Filters</a>
                    }
                    else
                    {
                        <p class="text-muted mb-4">Start by adding a new landing record.</p>
                        <a href="@Url.Action("Create")" class="btn btn-primary rounded-pill px-4 py-2"><i class="fas fa-plus-circle me-2"></i> Add New Landing Record</a>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-5 pt-4 border-top">
    <h2 class="h3 fw-bold text-dark mb-4"><i class="fas fa-chart-line me-2 text-info"></i>Key Performance Indicators</h2>
    <div class="row g-4">
        <div class="col-lg-6 col-md-12">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light py-3">
                    <h6 class="fw-semibold text-dark mb-0"><i class="fas fa-building me-2"></i>Landings by Status </h6>
                </div>
                <div class="card-body d-flex justify-content-center align-items-center">
                    <canvas id="landingsByOperatorChart" style="max-width: 450px; max-height: 350px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-md-12">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light py-3">
                    <h6 class="fw-semibold text-dark mb-0"><i class="fas fa-calendar-check me-2"></i>Landings in Last 30 Days</h6>
                </div>
                <div class="card-body">
                    <canvas id="last30DaysLandingsChart" style="max-height: 350px;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        body {
            background-color: #f8f9fa;
        }

        .card-header .collapse-icon {
            transition: transform 0.2s ease-in-out;
        }

        .card-header a[aria-expanded="true"] .collapse-icon {
            transform: rotate(180deg);
        }

        .request-card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }

            .request-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.1) !important;
            }
    </style>
}

@section Scripts {
    @* أولاً، قم بتضمين مكتبة Chart.js *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

    @* ثم ابدأ السكربت الخاص بك *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // --- بداية كود المخططات ---
            let landingsByOperatorChartInstance = null;
            let last30DaysLandingsChartInstance = null;

            const operatorChartColors = [
                'rgba(255, 99, 132, 0.7)', 'rgba(54, 162, 235, 0.7)', 'rgba(255, 206, 86, 0.7)',
                'rgba(75, 192, 192, 0.7)', 'rgba(153, 102, 255, 0.7)', 'rgba(255, 159, 64, 0.7)',
                'rgba(199, 199, 199, 0.7)', 'rgba(83, 102, 255, 0.7)', 'rgba(40, 159, 64, 0.7)',
                'rgba(210, 99, 132, 0.7)'
            ];
            const operatorChartBorderColors = operatorChartColors.map(color => color.replace('0.7', '1'));

            async function updateLandingsByOperatorChart() {
                try {
                    const response = await fetch('@Url.Action("GetLandingsByOperatorKpiData", "Landing")');
                    if (!response.ok) {
                        console.error("KPI Operator: Failed to fetch -", response.status, response.statusText);
                        document.getElementById('landingsByOperatorChart').parentElement.innerHTML = '<p class="text-danger text-center small">Error loading operator data.</p>';
                        return;
                    }
                    const kpiData = await response.json();
                    console.log("Operator KPI Data:", kpiData); // للتحقق من البيانات المستلمة
                    const landingsByOperatorCtx = document.getElementById('landingsByOperatorChart')?.getContext('2d');

                    if (!landingsByOperatorCtx) {
                        console.warn("Canvas for 'Landings by Operator' chart not found.");
                        return;
                    }

                    if (landingsByOperatorChartInstance) {
                        landingsByOperatorChartInstance.data.labels = kpiData.labels;
                        landingsByOperatorChartInstance.data.datasets[0].data = kpiData.data;
                        landingsByOperatorChartInstance.data.datasets[0].backgroundColor = operatorChartColors.slice(0, kpiData.labels.length);
                        landingsByOperatorChartInstance.data.datasets[0].borderColor = operatorChartBorderColors.slice(0, kpiData.labels.length);
                        landingsByOperatorChartInstance.update();
                    } else {
                        landingsByOperatorChartInstance = new Chart(landingsByOperatorCtx, {
                            type: 'doughnut',
                            data: {
                                labels: kpiData.labels,
                                datasets: [{
                                    label: 'Landings by Operator',
                                    data: kpiData.data,
                                    backgroundColor: operatorChartColors.slice(0, kpiData.labels.length),
                                    borderColor: operatorChartBorderColors.slice(0, kpiData.labels.length),
                                    borderWidth: 1
                                }]
                            },
                            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' } } }
                        });
                    }
                } catch (error) {
                    console.error("KPI Operator: JS Error -", error);
                    document.getElementById('landingsByOperatorChart').parentElement.innerHTML = '<p class="text-danger text-center small">Error processing operator data.</p>';
                }
            }

            async function updateLast30DaysLandingsChart() {
                try {
                    const response = await fetch('@Url.Action("GetLast30DaysLandingsKpiData", "Landing")');
                     if (!response.ok) {
                        console.error("KPI 30Days Landing: Failed to fetch -", response.status, response.statusText);
                        document.getElementById('last30DaysLandingsChart').parentElement.innerHTML = '<p class="text-danger text-center small">Error loading 30-day landing data.</p>';
                        return;
                    }
                    const kpiData = await response.json();
                    console.log("30 Days Landing KPI Data:", kpiData); // للتحقق من البيانات المستلمة
                    const last30DaysLandingsCtx = document.getElementById('last30DaysLandingsChart')?.getContext('2d');

                    if (!last30DaysLandingsCtx) {
                         console.warn("Canvas for 'Last 30 Days Landings' chart not found.");
                        return;
                    }

                    if (last30DaysLandingsChartInstance) {
                        last30DaysLandingsChartInstance.data.labels = kpiData.labels;
                        last30DaysLandingsChartInstance.data.datasets[0].data = kpiData.data;
                        last30DaysLandingsChartInstance.update();
                    } else {
                        last30DaysLandingsChartInstance = new Chart(last30DaysLandingsCtx, {
                            type: 'line',
                            data: {
                                labels: kpiData.labels,
                                datasets: [{
                                    label: 'Landings Recorded',
                                    data: kpiData.data,
                                    backgroundColor: 'rgba(0, 123, 255, 0.2)',
                                    borderColor: 'rgba(0, 123, 255, 1)',
                                    borderWidth: 2,
                                    tension: 0.3,
                                    fill: true
                                }]
                            },
                            options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }, plugins: { legend: { display: true, position: 'bottom' } } }
                        });
                    }
                } catch (error) {
                    console.error("KPI 30Days Landing: JS Error -", error);
                    document.getElementById('last30DaysLandingsChart').parentElement.innerHTML = '<p class="text-danger text-center small">Error processing 30-day landing data.</p>';
                }
            }

            updateLandingsByOperatorChart();
            updateLast30DaysLandingsChart();

            const updateInterval = 10000;
            let kpiIntervalId = setInterval(() => {
                console.log(`Updating Landing KPI charts at ${new Date().toLocaleTimeString()}`);
                updateLandingsByOperatorChart();
                updateLast30DaysLandingsChart();
            }, updateInterval);
            // --- نهاية كود المخططات ---


            // --- بداية كود filterCollapse (تم نقله ليكون داخل نفس DOMContentLoaded) ---
            const filterCollapseElement = document.getElementById('searchFilterCollapse');
            if (filterCollapseElement) {
                let hasActiveFilter = false;
                const filterInputs = filterCollapseElement.querySelectorAll('input[name="operatorName"], input[name="aircraftReg"], input[name="flightDateFrom"], input[name="flightDateTo"]');
                filterInputs.forEach(input => {
                    if (input.value && input.value.trim() !== '') { hasActiveFilter = true; }
                });
                if (hasActiveFilter) {
                   var bsCollapse = new bootstrap.Collapse(filterCollapseElement, { toggle: false });
                   if (bsCollapse) { // تأكد من أن bsCollapse تم تهيئته
                        bsCollapse.show();
                   }
                }
            }
            // --- نهاية كود filterCollapse ---

        }); // نهاية DOMContentLoaded
    </script>
}