                                        <th><i class="bi bi-airplane"></i> Callsign</th>
                                        <th><i class="bi bi-flag"></i> Country</th>
                                        <th><i class="bi bi-geo-alt"></i> Position</th>
                                        <th><i class="bi bi-speedometer2"></i> Altitude (m)</th>
                                        <th><i class="bi bi-arrow-up-right"></i> Velocity (m/s)</th>
                                        <th><i class="bi bi-compass"></i> Heading</th>
                                        <th><i class="bi bi-clock"></i> Last Contact</th>
                                    </tr>
                                </thead>
                                <tbody id="aircraftTableBody">
