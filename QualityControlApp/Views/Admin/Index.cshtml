                                <i class="bi bi-geo-alt-fill me-1"></i>Libya Region
                            </button>
                            <button class="btn btn-sm btn-info" id="btnRefreshAircraft">
                                <i class="bi bi-arrow-clockwise me-1"></i>Refresh Now
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" id="btnToggleView">
                                <i class="bi bi-map me-1"></i>Toggle Map/Table
                            </button>
                            <div class="ms-auto">
                                <span class="badge bg-secondary" id="aircraftCount">0 Aircraft</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="position-relative">
                    <div id="aircraftLoadingOverlay" class="map-loading-overlay" style="display: none;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    
                    <!-- Aircraft Map View -->
                    <div id="aircraftMapView" style="display: none;">
                        <div style="position: relative;">
                            <div id="aircraftMap" style="height: 600px; width: 100%; border-radius: 0.375rem; border: 1px solid #dee2e6;"></div>
                            <div class="live-update-indicator" id="aircraftMapLiveIndicator" style="position: absolute; top: 10px; right: 10px;">
                                <div class="live-indicator-dot"></div>
                                <span>Live Tracking</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Aircraft Table View -->
                    <div id="aircraftTableView">
                        <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                            <table class="table table-hover table-striped" id="aircraftTable">
