@section scripts {
    <!-- تضمين مكتبات الجافاسكريبت -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // =================================================================
            // Interactive Map with Live Updates
            // =================================================================
            let mapInstance = null;
            let markersLayer = null;
            let currentMarkers = {};
            const MAP_REFRESH_INTERVAL = 5000; // 5 seconds

            function initializeMap() {
                if (!document.getElementById('locationsMap')) {
                    console.log('Map container not found.');
                    return;
                }

                // Initialize map centered on Libya
                mapInstance = L.map('locationsMap', {
                    zoomControl: true,
                    scrollWheelZoom: true,
                    dragging: true,
                    doubleClickZoom: true
                }).setView([27.5, 17.0], 5);

                // Add tile layer
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                    maxZoom: 18
                }).addTo(mapInstance);

                // Initialize markers layer
                markersLayer = L.featureGroup().addTo(mapInstance);

                // Load initial data
                loadMapData();

                // Set up auto-refresh
                setInterval(loadMapData, MAP_REFRESH_INTERVAL);
            }

            function showLoadingOverlay(show) {
                const overlay = document.getElementById('mapLoadingOverlay');
                if (overlay) {
                    overlay.style.display = show ? 'flex' : 'none';
                }
            }

            function showError(message) {
                const errorDiv = document.getElementById('mapErrorMessage');
                if (errorDiv) {
                    errorDiv.textContent = message;
                    errorDiv.style.display = 'block';
                    setTimeout(() => {
                        errorDiv.style.display = 'none';
                    }, 5000);
                }
            }

            function updateLiveIndicator(isUpdating) {
                const indicator = document.getElementById('liveUpdateIndicator');
                if (!indicator) return;

                const dot = indicator.querySelector('.live-indicator-dot');
                const text = indicator.querySelector('span');

                if (isUpdating) {
                    dot.style.backgroundColor = '#007bff';
                    text.textContent = 'Updating...';
                } else {
                    dot.style.backgroundColor = '#28a745';
                    text.textContent = 'Live Update';
                }
            }

            function createMarkerIcon(status) {
                const color = status === 'active' ? '#28a745' : 
                             status === 'inactive' ? '#dc3545' : '#ffc107';
                
                return L.divIcon({
                    className: 'custom-marker',
                    html: `<div style="
                        width: 30px;
                        height: 30px;
                        background-color: ${color};
                        border: 3px solid white;
                        border-radius: 50%;
                        box-shadow: 0 2px 5px rgba(0,0,0,0.3);
                        cursor: pointer;
                    " class="${status === 'inactive' ? 'pulsing-marker' : 'pulsing-marker-active'}"></div>`,
                    iconSize: [30, 30],
                    iconAnchor: [15, 15],
                    popupAnchor: [0, -15]
                });
            }

            function createPopupContent(location) {
                const statusClass = location.status === 'active' ? 'active' : 
                                   location.status === 'inactive' ? 'inactive' : 'pending';
                const statusText = location.status.charAt(0).toUpperCase() + location.status.slice(1);
                
                const lastUpdate = location.lastUpdate ? 
                    new Date(location.lastUpdate).toLocaleString() : 'N/A';

                // Convert coordinates to numbers for display
                const lat = parseFloat(location.latitude);
                const lng = parseFloat(location.longitude);

                return `
                    <div>
                        <h6><i class="bi bi-geo-alt-fill me-1"></i>${location.name}</h6>
                        <div class="popup-info">
                            <div><strong>Status:</strong> <span class="status-badge ${statusClass}">${statusText}</span></div>
                            <div class="mt-2"><strong>Last Update:</strong><br>${lastUpdate}</div>
                            <div class="mt-1"><strong>Coordinates:</strong><br>${lat.toFixed(4)}, ${lng.toFixed(4)}</div>
                        </div>
                    </div>
                `;
            }

            function updateMarkers(locations) {
                if (!mapInstance || !markersLayer) return;

                const newMarkerIds = new Set();
                const hasActive = locations.some(loc => loc.status === 'active');

                locations.forEach((loc, idx) => {
                    // Convert latitude and longitude to numbers
                    const lat = parseFloat(loc.latitude);
                    const lng = parseFloat(loc.longitude);

                    // Validate coordinates
                    if (!lat || !lng || isNaN(lat) || isNaN(lng) || lat === 0 || lng === 0) {
                        console.warn('Invalid coordinates for location:', loc.name, lat, lng);
                        return;
                    }

                    // إذا لم يكن هناك علامات خضراء، اجعل أول علامة باللون الأخضر كتمييز بصري
                    const effectiveStatus = hasActive ? loc.status : (idx === 0 ? 'active' : loc.status);

                    const markerId = loc.id || `${lat}-${lng}`;
                    newMarkerIds.add(markerId);

                    if (currentMarkers[markerId]) {
                        // Update existing marker popup
                        currentMarkers[markerId].setPopupContent(createPopupContent({ ...loc, status: effectiveStatus, latitude: lat, longitude: lng }));
                    } else {
                        // Create new marker with animation
                        const marker = L.marker([lat, lng], {
                            icon: createMarkerIcon(effectiveStatus),
                            title: loc.name
                        });

                        marker.bindPopup(createPopupContent({ ...loc, status: effectiveStatus, latitude: lat, longitude: lng }), {
                            maxWidth: 300,
                            className: 'custom-popup'
                        });

                        // Add hover effect
                        marker.on('mouseover', function() {
                            this.openPopup();
                        });

                        markersLayer.addLayer(marker);
                        currentMarkers[markerId] = marker;
                    }
                });

                // Remove markers that no longer exist
                Object.keys(currentMarkers).forEach(markerId => {
                    if (!newMarkerIds.has(markerId)) {
                        markersLayer.removeLayer(currentMarkers[markerId]);
                        delete currentMarkers[markerId];
                    }
                });

                // Fit bounds if markers exist
                if (markersLayer.getLayers().length > 0) {
                    mapInstance.fitBounds(markersLayer.getBounds().pad(0.1));
                }
            }

            function loadMapData() {
                updateLiveIndicator(true);

                fetch('@Url.Action("GetLiveMapData", "Admin")')
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(result => {
                        if (result.success && result.data) {
                            updateMarkers(result.data);
                            
                            if (result.data.length === 0) {
                                const mapContainer = document.getElementById('locationsMap');
                                if (mapContainer && markersLayer.getLayers().length === 0) {
                                    showError('No active locations to display on the map.');
                                }
                            }
                        } else {
                            showError(result.error || 'Failed to load map data');
                        }
                    })
                    .catch(error => {
                        console.error('Error loading map data:', error);
                        showError('Connection error. Retrying...');
                    })
                    .finally(() => {
                        updateLiveIndicator(false);
                    });
            }

            // Initialize the map
            initializeMap();


            // =================================================================
            // Live Aircraft Tracking - OpenSky Network API
            // =================================================================
            let aircraftRefreshInterval = null;
            let currentAircraftFilter = null;
            let aircraftMapInstance = null;
            let aircraftMarkersLayer = null;
            let currentAircraftMarkers = {};
            let currentAircraftData = [];
            let isMapView = false;
            const AIRCRAFT_REFRESH_INTERVAL = 10000; // 10 seconds

            function showAircraftLoading(show) {
                const overlay = document.getElementById('aircraftLoadingOverlay');
                if (overlay) {
                    overlay.style.display = show ? 'flex' : 'none';
                }
            }

            function showAircraftError(message) {
                const errorDiv = document.getElementById('aircraftErrorMessage');
                if (errorDiv) {
                    errorDiv.textContent = message;
                    errorDiv.style.display = 'block';
                    setTimeout(() => {
                        errorDiv.style.display = 'none';
                    }, 5000);
                }
            }

            function updateAircraftIndicator(isUpdating) {
                const indicator = document.getElementById('aircraftLiveIndicator');
                if (!indicator) return;

                const dot = indicator.querySelector('.live-indicator-dot');
                const text = indicator.querySelector('span');

                if (isUpdating) {
                    dot.style.backgroundColor = '#007bff';
                    text.textContent = 'Updating...';
                } else {
                    dot.style.backgroundColor = '#28a745';
                    text.textContent = 'Live Data';
                }
            }

            function formatTimestamp(timestamp) {
                if (!timestamp) return 'N/A';
                const date = new Date(timestamp * 1000);
                const now = new Date();
                const diffSeconds = Math.floor((now - date) / 1000);
                
                if (diffSeconds < 60) return `${diffSeconds}s ago`;
                if (diffSeconds < 3600) return `${Math.floor(diffSeconds / 60)}m ago`;
                return date.toLocaleTimeString();
            }

            function parseAircraftData(apiResponse) {
                if (!apiResponse || !apiResponse.states) {
                    return [];
                }

                return apiResponse.states.map((state, index) => {
                    return {
                        icao24: state[0] || 'N/A',
                        callsign: (state[1] || 'Unknown').trim(),
                        originCountry: state[2] || 'Unknown',
                        timePosition: state[3],
                        lastContact: state[4],
                        longitude: state[5],
                        latitude: state[6],
                        baroAltitude: state[7],
                        onGround: state[8],
                        velocity: state[9],
                        trueTrack: state[10],
                        verticalRate: state[11],
                        geoAltitude: state[13],
                        squawk: state[14]
                    };
                }).filter(aircraft => 
                    aircraft.latitude !== null && 
                    aircraft.longitude !== null
                );
            }

            function initializeAircraftMap() {
                if (!document.getElementById('aircraftMap')) return;
                
                if (!aircraftMapInstance) {
                    aircraftMapInstance = L.map('aircraftMap', {
                        zoomControl: true,
                        scrollWheelZoom: true,
                        dragging: true,
                        doubleClickZoom: true
                    }).setView([27.5, 17.0], 5);

                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '© OpenStreetMap contributors',
                        maxZoom: 18
                    }).addTo(aircraftMapInstance);

                    aircraftMarkersLayer = L.featureGroup().addTo(aircraftMapInstance);
                }
            }

            function createAircraftIcon(aircraft) {
                const rotation = aircraft.trueTrack || 0;
                const color = aircraft.onGround ? '#6c757d' : '#007bff';
                
                return L.divIcon({
                    className: 'aircraft-marker',
                    html: `<div style="
                        width: 32px;
                        height: 32px;
                        transform: rotate(${rotation}deg);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                    ">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="${color}" style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));">
                            <path d="M21,16v-2l-8-5V3.5C13,2.67,12.33,2,11.5,2S10,2.67,10,3.5V9l-8,5v2l8-2.5V19l-2,1.5V22l3.5-1l3.5,1v-1.5L13,19v-5.5L21,16z"/>
                        </svg>
                    </div>`,
                    iconSize: [32, 32],
                    iconAnchor: [16, 16],
                    popupAnchor: [0, -16]
                });
            }

            function createAircraftPopup(aircraft) {
                const altitude = aircraft.baroAltitude !== null ? 
                    Math.round(aircraft.baroAltitude) + ' m' : 'N/A';
                const velocity = aircraft.velocity !== null ? 
                    aircraft.velocity.toFixed(1) + ' m/s' : 'N/A';
                const heading = aircraft.trueTrack !== null ? 
                    Math.round(aircraft.trueTrack) + '°' : 'N/A';
                const lastContact = formatTimestamp(aircraft.lastContact);
                const statusBadge = aircraft.onGround ? 
                    '<span class="badge bg-warning text-dark">On Ground</span>' : 
                    '<span class="badge bg-success">In Flight</span>';

                return `
                    <div style="min-width: 200px;">
                        <h6><i class="bi bi-airplane-fill me-1"></i>${aircraft.callsign}</h6>
                        <div class="popup-info">
                            <div><strong>Country:</strong> ${aircraft.originCountry}</div>
                            <div><strong>Status:</strong> ${statusBadge}</div>
                            <div class="mt-2"><strong>Altitude:</strong> ${altitude}</div>
                            <div><strong>Velocity:</strong> ${velocity}</div>
                            <div><strong>Heading:</strong> ${heading}</div>
                            <div class="mt-2"><strong>Position:</strong><br>
                                <small>${aircraft.latitude.toFixed(4)}, ${aircraft.longitude.toFixed(4)}</small>
                            </div>
                            <div class="mt-1"><strong>Last Contact:</strong> ${lastContact}</div>
                        </div>
                    </div>
                `;
            }

            function updateAircraftMap(aircraftList) {
                if (!aircraftMapInstance || !aircraftMarkersLayer) return;

                const newMarkerIds = new Set();

                aircraftList.forEach(aircraft => {
                    const markerId = aircraft.icao24;
                    newMarkerIds.add(markerId);

                    if (currentAircraftMarkers[markerId]) {
                        // Update existing marker
                        const marker = currentAircraftMarkers[markerId];
                        marker.setLatLng([aircraft.latitude, aircraft.longitude]);
                        marker.setIcon(createAircraftIcon(aircraft));
                        marker.setPopupContent(createAircraftPopup(aircraft));
                    } else {
                        // Create new marker
                        const marker = L.marker([aircraft.latitude, aircraft.longitude], {
                            icon: createAircraftIcon(aircraft),
                            title: aircraft.callsign
                        });

                        marker.bindPopup(createAircraftPopup(aircraft), {
                            maxWidth: 300,
                            className: 'custom-popup'
                        });

                        marker.on('mouseover', function() {
                            this.openPopup();
                        });

                        aircraftMarkersLayer.addLayer(marker);
                        currentAircraftMarkers[markerId] = marker;
                    }
                });

                // Remove markers that no longer exist
                Object.keys(currentAircraftMarkers).forEach(markerId => {
                    if (!newMarkerIds.has(markerId)) {
                        aircraftMarkersLayer.removeLayer(currentAircraftMarkers[markerId]);
                        delete currentAircraftMarkers[markerId];
                    }
                });

                // Fit bounds if markers exist
                if (aircraftMarkersLayer.getLayers().length > 0) {
                    aircraftMapInstance.fitBounds(aircraftMarkersLayer.getBounds().pad(0.1));
                }
            }

            function updateAircraftTable(aircraftList) {
                const tbody = document.getElementById('aircraftTableBody');
                const countBadge = document.getElementById('aircraftCount');
                
                if (!tbody) return;

                if (aircraftList.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bi bi-airplane fs-1 d-block mb-2"></i>
                                No aircraft data available
                            </td>
                        </tr>
                    `;
                    if (countBadge) countBadge.textContent = '0 Aircraft';
                    return;
                }

                let html = '';
                aircraftList.forEach((aircraft, index) => {
                    const altitude = aircraft.baroAltitude !== null ? 
                        Math.round(aircraft.baroAltitude) : 'N/A';
                    const velocity = aircraft.velocity !== null ? 
                        aircraft.velocity.toFixed(1) : 'N/A';
                    const heading = aircraft.trueTrack !== null ? 
                        Math.round(aircraft.trueTrack) + '°' : 'N/A';
                    const position = `${aircraft.latitude.toFixed(4)}, ${aircraft.longitude.toFixed(4)}`;
                    const lastContact = formatTimestamp(aircraft.lastContact);
                    
                    const rowClass = aircraft.onGround ? 'table-secondary' : '';
                    
                    html += `
                        <tr class="${rowClass}">
                            <td>${index + 1}</td>
                            <td>
                                <strong>${aircraft.callsign}</strong>
                                ${aircraft.onGround ? '<span class="badge bg-warning text-dark ms-1">Ground</span>' : ''}
                            </td>
                            <td>${aircraft.originCountry}</td>
                            <td><small>${position}</small></td>
                            <td>${altitude}</td>
                            <td>${velocity}</td>
                            <td>${heading}</td>
                            <td><small>${lastContact}</small></td>
                        </tr>
                    `;
                });

                tbody.innerHTML = html;
                if (countBadge) {
                    countBadge.textContent = `${aircraftList.length} Aircraft`;
                    countBadge.className = 'badge bg-success';
                }
            }

            function loadAircraftData(bounds = null) {
                updateAircraftIndicator(true);
                showAircraftLoading(true);

                let url = '@Url.Action("GetLiveAircraftData", "Admin")';
                
                if (bounds) {
                    const params = new URLSearchParams({
                        lamin: bounds.lamin,
                        lomin: bounds.lomin,
                        lamax: bounds.lamax,
                        lomax: bounds.lomax
                    });
                    url += '?' + params.toString();
                }

                fetch(url)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success === false) {
                            showAircraftError(data.error || 'Failed to load aircraft data');
                            updateAircraftTable([]);
                            currentAircraftData = [];
                        } else {
                            const aircraftList = parseAircraftData(data);
                            currentAircraftData = aircraftList;
                            updateAircraftTable(aircraftList);
                            
                            // Update map if in map view
                            if (isMapView && aircraftMapInstance) {
                                updateAircraftMap(aircraftList);
                            }
                        }
                    })
                    .catch(error => {
                        console.error('Error loading aircraft data:', error);
                        showAircraftError('Connection error. Please try again.');
                        updateAircraftTable([]);
                    })
                    .finally(() => {
                        updateAircraftIndicator(false);
                        showAircraftLoading(false);
                    });
            }

            function startAircraftAutoRefresh(bounds = null) {
                if (aircraftRefreshInterval) {
                    clearInterval(aircraftRefreshInterval);
                }
                
                currentAircraftFilter = bounds;
                aircraftRefreshInterval = setInterval(() => {
                    loadAircraftData(currentAircraftFilter);
                }, AIRCRAFT_REFRESH_INTERVAL);
            }

            function stopAircraftAutoRefresh() {
                if (aircraftRefreshInterval) {
                    clearInterval(aircraftRefreshInterval);
                    aircraftRefreshInterval = null;
                }
            }

            // Button event handlers
            document.getElementById('btnLoadAllAircraft')?.addEventListener('click', function() {
                loadAircraftData(null);
                startAircraftAutoRefresh(null);
            });

            document.getElementById('btnLoadLibyaAircraft')?.addEventListener('click', function() {
                // Libya region bounds (approximate)
                const libyaBounds = {
                    lamin: 19.5,  // Southern latitude
                    lomin: 9.0,   // Western longitude
                    lamax: 33.5,  // Northern latitude
                    lomax: 25.5   // Eastern longitude
                };
                loadAircraftData(libyaBounds);
                startAircraftAutoRefresh(libyaBounds);
            });

            document.getElementById('btnRefreshAircraft')?.addEventListener('click', function() {
                loadAircraftData(currentAircraftFilter);
            });

            // Toggle between map and table view
            document.getElementById('btnToggleView')?.addEventListener('click', function() {
                const mapView = document.getElementById('aircraftMapView');
                const tableView = document.getElementById('aircraftTableView');
                const toggleBtn = this;

                if (isMapView) {
                    // Switch to table view
                    mapView.style.display = 'none';
                    tableView.style.display = 'block';
                    toggleBtn.innerHTML = '<i class="bi bi-map me-1"></i>Show Map';
                    isMapView = false;
                } else {
                    // Switch to map view
                    tableView.style.display = 'none';
                    mapView.style.display = 'block';
                    toggleBtn.innerHTML = '<i class="bi bi-table me-1"></i>Show Table';
                    isMapView = true;

                    // Initialize map if not already done
                    initializeAircraftMap();

                    // Update map with current data
                    if (currentAircraftData.length > 0) {
                        updateAircraftMap(currentAircraftData);
                    }

                    // Invalidate map size to fix display issues
                    setTimeout(() => {
                        if (aircraftMapInstance) {
                            aircraftMapInstance.invalidateSize();
                        }
                    }, 100);
                }
            });


            // =================================================================
            // تهيئة الشارتات والمنطق الخاص بها
            // =================================================================
            const REFRESH_INTERVAL_MS = 30000;

            function handleLoadingState(chartId, isLoading, error = null) {
                const loadingIndicator = document.getElementById(`${chartId}LoadingIndicator`);
                const chartElement = document.getElementById(chartId);
                const errorMessageElement = loadingIndicator?.querySelector('.chart-error-message');
                if (loadingIndicator) loadingIndicator.style.display = isLoading ? 'block' : 'none';
                if (chartElement) chartElement.classList.toggle('chart-loading', isLoading);
                if (errorMessageElement) {
                    errorMessageElement.style.display = error ? 'block' : 'none';
                    errorMessageElement.textContent = error ? `Data loading failed: ${error}` : '';
                }
            }

            const apexChartColors = {
                active: '#28a745', inactive: '#dc3545',
                pending: '#ffc107', approved: '#17a2b8', rejected: '#6c757d',
            };

            Apex.chart = { fontFamily: 'inherit', toolbar: { show: false } };
            Apex.tooltip = { theme: 'dark' };

            // --- الشارت الأول: Over Site Status (questionsChart) ---
            let questionsChartInstance;
            const questionsChartElement = document.getElementById('questionsChart');
            const questionsStatusCountsElement = document.getElementById('questionsStatusCounts');
            const filterForm = document.getElementById('filterForm');

            const questionsChartOptions = {
                series: [], chart: { type: 'donut', height: 250, width: '100%' },
                labels: ['Active', 'Inactive'], colors: [apexChartColors.active, apexChartColors.inactive],
                responsive: [{ breakpoint: 480, options: { chart: { width: 200 }, legend: { position: 'bottom' } } }],
                legend: { position: 'bottom' },
                dataLabels: {
                    enabled: true,
                    formatter: (val, opts) => `${val.toFixed(1)}% (${opts.w.config.series[opts.seriesIndex]})`,
                    style: { fontSize: '11px', colors: ["#fff"] },
                    dropShadow: { enabled: true, top: 1, left: 1, blur: 1, color: '#000', opacity: 0.45 }
                },
                plotOptions: { pie: { donut: { labels: { show: true, name: { show: true, offsetY: -10 }, value: { show: true, offsetY: 10, formatter: (val) => val }, total: { show: true, showAlways: true, label: 'Total', formatter: (w) => w.globals.seriesTotals.reduce((a, b) => a + b, 0) } } } } }
            };

            if (questionsChartElement) {
                questionsChartInstance = new ApexCharts(questionsChartElement, questionsChartOptions);
                questionsChartInstance.render();
            }

            function updateQuestionsChartData(active, inactive) {
                handleLoadingState('questionsChart', false);
                if (questionsChartInstance) questionsChartInstance.updateSeries([active, inactive]);
                if (questionsStatusCountsElement) {
                    document.getElementById('questionsActiveCount').textContent = active;
                    document.getElementById('questionsInactiveCount').textContent = inactive;
                    questionsStatusCountsElement.style.display = 'block';
                }
            }

            function fetchAndRefreshOverSiteChart() {
                if (!questionsChartElement) return;
                handleLoadingState('questionsChart', true);
                if (questionsStatusCountsElement) questionsStatusCountsElement.style.display = 'none';
                const fromDate = document.getElementById('fromDate').value;
                const toDate = document.getElementById('toDate').value;
                const companyId = document.getElementById('companyId').value;
                const fetchUrl = new URL('@Url.Action("GetChartData", "Admin")', window.location.origin);
                if(fromDate) fetchUrl.searchParams.append('fromDate', fromDate);
                if(toDate) fetchUrl.searchParams.append('toDate', toDate);
                if(companyId) fetchUrl.searchParams.append('companyId', companyId);

                fetch(fetchUrl)
                    .then(response => response.ok ? response.json() : response.text().then(text => { throw new Error(text) }))
                    .then(data => updateQuestionsChartData(data.activeQuestions, data.inactiveQuestions))
                    .catch(error => {
                        console.error('Error fetching Over Site chart data:', error);
                        handleLoadingState('questionsChart', false, error.message);
                    });
            }

            if (questionsChartElement) updateQuestionsChartData(@(ViewBag.ActiveQuestions ?? 0), @(ViewBag.InactiveQuestions ?? 0));
            if (filterForm) filterForm.addEventListener('submit', (e) => { e.preventDefault(); fetchAndRefreshOverSiteChart(); });

            // --- الشارت الثاني: AirRequest Status (requestStatusChart) ---
            let requestStatusChartInstance;
            const requestStatusChartElement = document.getElementById('requestStatusChart');
            const requestStatusChartOptions = { /* ... نفس الخيارات السابقة ... */ };
            if (requestStatusChartElement) { /* ... نفس الكود السابق ... */ }
            function updateRequestStatusChartData(data) { /* ... نفس الكود السابق ... */ }
            function fetchRequestStatusData() { /* ... نفس الكود السابق ... */ }


            // --- الشارت الثالث: Landing Request Status (landingRequestStatusChart) ---
            let landingRequestChartInstance;
            const landingRequestChartElement = document.getElementById('landingRequestStatusChart');
            const landingRequestChartOptions = { /* ... نفس الخيارات السابقة ... */ };
            if (landingRequestChartElement) { /* ... نفس الكود السابق ... */ }
            function updateLandingRequestChartData(data) { /* ... نفس الكود السابق ... */ }
            function fetchLandingRequestData() { /* ... نفس الكود السابق ... */ }

            // --- تحميل البيانات المبدئي والتحديث الدوري ---
            if (requestStatusChartElement) fetchRequestStatusData();
            if (landingRequestChartElement) fetchLandingRequestData();

            if (questionsChartElement) setInterval(fetchAndRefreshOverSiteChart, REFRESH_INTERVAL_MS);
            if (requestStatusChartElement) setInterval(fetchRequestStatusData, REFRESH_INTERVAL_MS);
            if (landingRequestChartElement) setInterval(fetchLandingRequestData, REFRESH_INTERVAL_MS);

        });
    </script>
}