@{
    ViewData["Title"] = "Dashboard";
}

@* 1. تأكد من أن رابط Leaflet CSS موجود هنا أو في _Layout.cshtml *@
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<style>
    body {
        background-color: #fff !important; /* Ensures white background for the entire page */
    }

    .stat-icon-wrapper {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        float: right;
    }

        .stat-icon-wrapper i {
            font-size: 1.5rem;
        }

    .bg-primary-soft {
        background-color: rgba(var(--bs-primary-rgb), 0.15);
    }

    .bg-success-soft {
        background-color: rgba(var(--bs-success-rgb), 0.15);
    }

    .bg-info-soft {
        background-color: rgba(var(--bs-info-rgb), 0.15);
    }

    .bg-warning-soft {
        background-color: rgba(var(--bs-warning-rgb), 0.15);
    }

    .bg-danger-soft {
        background-color: rgba(var(--bs-danger-rgb), 0.15);
    }

    .bg-purple-soft {
        background-color: rgba(111, 66, 193, 0.15);
    }

    .bg-teal-soft {
        background-color: rgba(32, 201, 151, 0.15);
    }

    .apexcharts-canvas {
        transition: opacity 0.3s ease-in-out;
    }

    .chart-loading .apexcharts-canvas {
        opacity: 0.3;
    }

    .chart-container {
        min-height: 250px;
    }

    #locationsMap {
        height: 450px;
        width: 100%;
        border-radius: 0.375rem;
        border: 1px solid #dee2e6;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        position: relative;
    }

    .leaflet-popup-content-wrapper {
        border-radius: 0.375rem;
        box-shadow: 0 3px 14px rgba(0,0,0,0.4);
    }

    .leaflet-popup-content {
        font-weight: 500;
        margin: 13px 19px;
        line-height: 1.4;
    }

    .leaflet-popup-content h6 {
        margin: 0 0 8px 0;
        font-size: 1rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .leaflet-popup-content .popup-info {
        font-size: 0.875rem;
        color: #6c757d;
    }

    .leaflet-popup-content .status-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-top: 5px;
    }

    .status-badge.active {
        background-color: #d4edda;
        color: #155724;
    }

    .status-badge.inactive {
        background-color: #f8d7da;
        color: #721c24;
    }

    .status-badge.pending {
        background-color: #fff3cd;
        color: #856404;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
        }
        70% {
            box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }
    }

    @@keyframes pulse-active {
        0% {
            box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7);
        }
        70% {
            box-shadow: 0 0 0 10px rgba(40, 167, 69, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(40, 167, 69, 0);
        }
    }

    .pulsing-marker {
        animation: pulse 2s infinite;
    }

    .pulsing-marker-active {
        animation: pulse-active 2s infinite;
    }

    .leaflet-marker-icon:hover {
        transform: scale(1.2);
        transition: transform 0.2s ease-in-out;
        z-index: 1000 !important;
    }

    .live-update-indicator {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(255, 255, 255, 0.95);
        padding: 8px 15px;
        border-radius: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .live-indicator-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #28a745;
        animation: blink 1.5s infinite;
    }

    @@keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }

    .update-spinner {
        width: 12px;
        height: 12px;
        border: 2px solid #f3f3f3;
        border-top: 2px solid #007bff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .map-loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        border-radius: 0.375rem;
    }

    .error-message {
        color: #dc3545;
        font-size: 0.875rem;
        padding: 10px;
        background: #f8d7da;
        border-radius: 5px;
        margin-top: 10px;
    }
</style>

<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0"><i class="bi bi-map-fill me-2"></i>Open Oversight Tasks - Live Map</h5>
                <small class="text-muted">Auto-refresh every 5 seconds</small>
            </div>
            <div class="card-body p-2">
                <div style="position: relative;">
                    <div id="locationsMap"></div>
                    <div class="live-update-indicator" id="liveUpdateIndicator">
                        <div class="live-indicator-dot"></div>
                        <span>Live Update</span>
                    </div>
                    <div class="map-loading-overlay" id="mapLoadingOverlay" style="display: none;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
                <div id="mapErrorMessage" class="error-message" style="display: none;"></div>
            </div>
        </div>
    </div>
</div>

