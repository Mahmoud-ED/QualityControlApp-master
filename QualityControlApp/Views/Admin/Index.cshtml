<!-- قسم تتبع الطائرات الحية - OpenSky Network -->
<div class="row mt-3">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="bi bi-airplane-fill me-2"></i>Live Aircraft Tracking - OpenSky Network
                </h5>
                <div class="d-flex align-items-center gap-3">
                    <small class="text-muted">Auto-refresh every 10 seconds</small>
                    <div class="live-update-indicator" id="aircraftLiveIndicator" style="position: relative; top: 0; right: 0;">
                        <div class="live-indicator-dot"></div>
                        <span>Live Data</span>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="d-flex gap-2 align-items-center flex-wrap">
                            <button class="btn btn-sm btn-primary" id="btnLoadAllAircraft">
                                <i class="bi bi-globe me-1"></i>Load All Aircraft
                            </button>
