@model QualityControlApp.Models.Entities.ImgeForViews

@{
    ViewData["Title"] = "Create Image for View";
}

<h1>@ViewData["Title"]</h1>

<h4>ImgeForViews</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data">
            @* مهم لتحميل الملفات *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="ViewName" class="control-label"></label>
                <input asp-for="ViewName" class="form-control" />
                <span asp-validation-for="ViewName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CoverImage" class="control-label"></label>
                <input asp-for="CoverImage" class="form-control" type="file" />
                <span asp-validation-for="CoverImage" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}