@model QualityControlApp.Models.Entities.ImgeForViews

@{
    ViewData["Title"] = "Edit Image for View";
}

<h1>@ViewData["Title"]</h1>

<h4>ImgeForViews</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            @* مهم لتحميل الملفات *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CoverImageUrl" /> @* لحفظ المسار الحالي إذا لم يتم تغيير الصورة *@

            <div class="form-group mb-3">
                <label asp-for="ViewName" class="control-label"></label>
                <input asp-for="ViewName" class="form-control" />
                <span asp-validation-for="ViewName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CoverImage" class="control-label"></label>
                @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                {
                    <div class="mb-2">
                        <img src="@Model.CoverImageUrl" alt="Current Cover Image" style="max-width: 200px; max-height: 200px; display: block;" />
                        <small class="form-text text-muted">Current Image. Upload a new one to replace it.</small>
                    </div>
                }
                <input asp-for="CoverImage" class="form-control" type="file" />
                <span asp-validation-for="CoverImage" class="text-danger"></span>
                <small class="form-text text-muted">Leave empty if you don't want to change the current image.</small>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}