@model QualityControlApp.Models.Entities.FileType

@{
    ViewBag.Title = "File type";
}

<h2 class="mb-4">Create Type</h2>

<form asp-action="Create" method="post" class="row g-3">

    <div class="col-md-6">
        <div class="form-floating">
            <input asp-for="TypeName" class="form-control" placeholder="File type" />
            <label asp-for="TypeName">File type</label>
            <span asp-validation-for="TypeName" class="text-danger"></span>
        </div>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-success">Create</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
