@* Views/ChronicDisease/Index.cshtml *@
@model QualityControlApp.ViewModels.ChronicDiseaseIndexViewModel
@{
    ViewData["Title"] = "الأمراض المزمنة";
}
@* ... TempData display ... *@
<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                @* ... Add Form (as before) ... *@

                <h6 class="mb-3 mt-5">قائمة الأمراض المزمنة الحالية</h6>
                @if (Model.ChronicDiseases != null && Model.ChronicDiseases.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>@Html.DisplayNameFor(model => model.NewChronicDisease.Name)</th>
                                    <th>@Html.DisplayNameFor(model => model.NewChronicDisease.Description)</th>
                                    <th>تاريخ الإنشاء</th> @* Added CreatedAt *@
                                    <th>إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ChronicDiseases.OrderByDescending(i => i.Created)) 
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Description)</td>
                                        <td>@item.Created.ToString("yyyy/MM/dd HH:mm")</td> @* Format CreatedAt *@
                                        <td>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1" title="تعديل">
                                                <i class="fas fa-edit"></i> @*تعديل*@
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد أنك تريد حذف هذا المرض المزمن: \'@item.Name.Replace("'", "\\'")\'؟');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger" title="حذف">
                                                    <i class="fas fa-trash"></i> @*حذف*@
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        لا توجد أمراض مزمنة مسجلة حاليًا.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}